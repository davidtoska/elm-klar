            , { name = "noPresets", type_ = "Flag", description = "No list of quick choices: only the calendar is shown.", control = Choice [ "Enabled", "omit" ] }
            ]

        "TimePicker" ->
            [ { name = "label", type_ = "String", description = "The label above the field, tied to the text input. Give every field a label, or hide it with `labelHidden`: it is the name that screen readers announce.", control = Text }
