            , { name = "max", type_ = "Date", description = "The latest date that can be chosen or typed. A typed date after it shows \"The date cannot be after\" followed by the limit, the calendar disables the later days, and the quick choices are cut to it (one that starts after it is disabled). Default: no limit.", control = Text }
            , { name = "disabledWhen", type_ = "(Date -> Bool)", description = "Dates that cannot be used, such as weekends or public holidays. The calendar shows them disabled and a typed one shows \"The date is not available\". A quick choice never starts or ends on one: it is cut inward to the nearest allowed day, and disabled when no day of it is allowed. Default: every date is allowed.", control = Example }
            , { name = "maxRangeDays", type_ = "Int", description = "The longest period allowed, in days, counting both end days. In the calendar, days that would make the period longer are disabled once the first day is chosen; a typed period that is longer shows \"The period cannot be longer than\" followed by the number of days, and quick choices that are longer (after being cut to the limits) are disabled. Default", control = Number }
            , { name = "markers", type_ = "List Calendar.Marker", description = "Marks on days in the calendar, such as deliveries or deadlines. Make them with `Calendar.dot` and `Calendar.count` from [Klar.Calendar](Klar-Calendar). Default: none.", control = Example }
