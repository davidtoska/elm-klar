            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the titles, the filter boxes, the counts, the button names, the announcement after a move and the labels for screen readers. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "DatePicker" ->
            [ { name = "label", type_ = "String", description = "The label above the field, tied to the text input. Give every field a label, or hide it with `labelHidden`: it is the name that screen readers announce.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keeps the label for screen readers but does not show it, for a field in a toolbar or a table row. Needs `label`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A short help text below the field. It is linked to the input with `aria-describedby`, so screen readers read it together with the field.", control = Text }
            , { name = "error", type_ = "String", description = "An error message from your application, shown below the field and announced to screen readers: a required date that is missing, or a date that conflicts with another field. While the picker has a complaint of its own about the typed text (\"Invalid date\"), that message is shown instead.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Nothing` means no error. Convenient when the message lives in a `Maybe` in your model.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label, and `aria-required` on the input. The picker does not enforce it; when the date is missing, test `value` for `Nothing` yourself and pass an `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "invalid", type_ = "Bool", description = "Marks the field as invalid without a message of its own: `aria-invalid` on the input and the red border. For a field whose message is shown somewhere else, such as below a group of fields or in a summary of the form; to show a message below the field, use `error`. Takes a `Bool` so that it can come from your model. Default: `False`.", control = Choice [ "True", "False" ] }
            , { name = "optionalText", type_ = "String", description = "Text shown after the label of a field that is not `required`, such as \"(optional)\". Default: none.", control = Text }
            , { name = "placeholder", type_ = "String", description = "The text shown in the empty field. Default: the format hint of the locale, `yyyy-mm-dd` in English.", control = Text }
            , { name = "disabled", type_ = "Bool", description = "Disables the field and its calendar button: the text cannot be focused or changed and the calendar cannot be opened. Takes a `Bool` so that it can come straight from your model, for example while a form is saving. Default: `False`.", control = Choice [ "True", "False" ] }
