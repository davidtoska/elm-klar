            , { name = "onRangeCommit", type_ = "(Float -> Float -> msg)", description = "Like `onCommit`, for a range slider (`viewRange`): sent once when either thumb is let go, and after every key press. It gets the lower and the upper value, limited and kept apart like those of `onRangeInput`.", control = Example }
