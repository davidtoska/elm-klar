            , { name = "readOnly", type_ = "Bool", description = "The time can be seen, selected and copied but not changed, and the list does not open. Unlike `disabled`, the field can still be focused. Default: `False`.", control = Choice [ "True", "False" ] }
            , { name = "clearable", type_ = "Flag", description = "Shows a small × button in the field while it has text; it empties the field and puts the focus back in it. The button is not in the tab order, and its accessible name is \"Clear field\". Default: no button.", control = Choice [ "Enabled", "omit" ] }
