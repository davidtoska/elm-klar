            , { name = "minTime", type_ = "Time", description = "The earliest time of day that can be chosen or typed, on every date. Default: 00:00.", control = Example }
            , { name = "maxTime", type_ = "Time", description = "The latest time of day that can be chosen or typed, on every date. Default: 23:59.", control = Example }
            ]

        "Calendar" ->
            [ { name = "min", type_ = "Date", description = "The earliest day that can be chosen. Earlier days are disabled, keyboard movement stops at the limit, and the button for the previous month is disabled once no day of that month can be chosen. Default: 1 January of year 1.", control = Text }
            , { name = "max", type_ = "Date", description = "The latest day that can be chosen. Later days are disabled, keyboard movement stops at the limit, and the button for the next month is disabled once no day of that month can be chosen. Default: 31 December 9999.", control = Text }
            , { name = "disabledWhen", type_ = "(Date -> Bool)", description = "Days the user cannot choose, such as weekends or days a warehouse is closed. They are drawn dimmed, announced as disabled, and cannot be picked; the arrow keys can still move onto them. Default: no day is disabled.", control = Example }
            , { name = "maxRangeDays", type_ = "Int", description = "The longest period a range calendar accepts, in days, counting both end days: once the first day is chosen, days that would make the period longer are disabled. It has no effect on a calendar made with `init`. Default: no limit.", control = Number }
            , { name = "weekNumbers", type_ = "Flag", description = "Shows a column with the ISO 8601 week number of every row (the week with the year's first Thursday is week 1; a row has the number of its Thursday). Default: off.", control = Choice [ "Enabled", "omit" ] }
            , { name = "todayButton", type_ = "Flag", description = "Shows a \"Today\" button below the days that takes the calendar back to the month of today and puts the focus on today; it does not choose the day. It needs `setToday`, and is disabled when today is outside `min` and `max` or excluded by `disabledWhen`. Default: no button.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "The size of the calendar, a `Size` from [Klar.Theme](Klar-Theme). Default: `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: month and weekday names, button labels, the spoken label of every day and the announcements. The columns, `Home` and `End` follow its first day of the week (`Locale.firstDayOfWeek`; Monday in both languages). Saturday and Sunday are drawn as the weekend. The default is `Locale.default`, which is English; see [Klar", control = Choice [ "en", "nb" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the calendar, read by screen readers when the focus enters it; nothing is drawn. Default: \"Calendar\".", control = Text }
            , { name = "markers", type_ = "List Marker", description = "Marks that are always there, such as holidays, or the dates of a [Klar.Recurrence](Klar-Recurrence) rule; see `dot` and `count`. For marks from a backend use `remote` instead (the last of the two wins). The list may be long: only the marks of the visible months are drawn. Default: none.", control = Example }
            , { name = "remote", type_ = "Remote (List Marker)", description = "Marks from a backend, as a `Remote` (see [Klar.Remote](Klar-Remote)); use it instead of `markers`. The days can be chosen in every state, and the grid around them is the same in every state, so the keyboard focus stays where it is. While the marks are `NotAsked` or `Loading` the line under the days says \"Loading\" (a polite live region, so a screen ", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale", "Empty" ] }
            , { name = "onRetry", type_ = "msg", description = "The message of the \"Try again\" button shown when the marks of `remote` failed. The button goes away while the marks load again, so give the focus back with `focus` in the same `update` branch, as in the module example:", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (see [Klar.Settings](Klar-Settings)), for the time zone of \"Old data from 14:05\". Default: `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "RecurrencePicker" ->
            [ { name = "label", type_ = "String", description = "The legend of the field: its name, above the choices. Without it the legend is the built-in \"Repeat\", kept for screen readers only.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keeps the label for screen readers but does not show it, for a field whose purpose is clear from what surrounds it. Needs `label`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A line of help under the field. It describes the whole group (`aria-describedby`), so screen readers read it when the focus enters.", control = Text }
            , { name = "error", type_ = "String", description = "An error message of your application, shown under the field and announced to screen readers (`role=\"alert\"`). While the field has a problem of its own (see `problem`) that message is shown instead.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Nothing` means no error.", control = Text }
            , { name = "required", type_ = "Flag", description = "Puts a `*` after the label. It only marks the field and checks nothing: \"Does not repeat\" is a valid answer.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text shown after the label of a field that is not `required`, such as \"(optional)\". Default: none.", control = Text }
            , { name = "today", type_ = "Date", description = "Today, from the application (the library never reads the clock). The date field of \"ends on\" marks it, and the next dates start from today when it is later than the start date. Without it the list shows the first dates of the series.", control = Text }
            , { name = "size", type_ = "Size", description = "The size of the controls: `Small`, `Medium` or `Large` (see [Klar.Theme](Klar-Theme)). Default: `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, of the sentence and of the dates (see [Klar.Locale](Klar-Locale)). Default: `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            , { name = "disabled", type_ = "Bool", description = "Disables every control. Takes a `Bool` so that it can come from your model, for example while a form is saved. Default: `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "Shows the label and the sentence only (\"Every 2 weeks on Monday and Thursday\"), with no controls and no list of dates, for a page that displays a saved rule. Default: `False`.", control = Choice [ "True", "False" ] }
            ]

        "Table" ->
            [ { name = "columns", type_ = "List (Column row msg)", description = "The columns of the table, left to right. Make them with `text`, `int`, `float`, `date`, `maybeDate`, `badge`, `status`, `bool`, `custom` and `actions`. Column ids must be unique and stay the same: sort, filters, hidden columns and the `Query` refer to them.", control = Example }
            , { name = "remote", type_ = "Remote (List row)", description = "The rows, as [Klar.Remote](Klar-Remote) data. `Loading` (and `NotAsked`) shows skeleton rows under the header, `Failed` shows the error with a retry button (see `onRetry`), and `Loaded []` shows the empty state (see `emptyState`). In server mode these are the rows of the current page only. Without `remote` the table shows the loading skeleton.", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale", "Empty" ] }
            , { name = "remotePrepared", type_ = "Remote (Rows row)", description = "The rows of a client-mode table that has thousands of them, as `Rows` made once with `prepareRows` (see \"Many rows\" at the top), instead of `remote`. It does what `remote` does, and the search and a sort by one column no longer format every value again on each message.", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale" ] }
            , { name = "rowId", type_ = "Ids id -> (row -> id)", description = "A stable, unique id for each row, such as a database id. Selection, expanded rows and keyed rendering depend on it; without it rows are identified by their position in the current (filtered and sorted) result, so a selection or an open row does not follow its row when the order changes, and `selectable` needs it.", control = Example }
            , { name = "rowLabel", type_ = "(row -> String)", description = "How screen readers name a row, for example in the label of its checkbox (\"Select Ada Lovelace\"), its expand button and its actions menu. The default is the text of the first visible column.", control = Example }
            , { name = "server", type_ = "{ total : Int }", description = "Switches to server mode: `remote` is the current page and `total` the number of rows that match the query. The table does not search, filter, sort or slice the rows itself; it shows the pagination for `total` and records what the user asks for, which you read with `query`. Without this attribute the table is in client mode.", control = Example }
            , { name = "ariaLabel", type_ = "String", description = "The name of the table that screen readers hear, such as \"Orders\" (it is not shown: a visible title is a heading of your own above the table). It also makes the scrolling area a labelled region and names the page controls in the footer (\"Pages of Orders\"), so that two tables on a page can be told apart. Give every table one.", control = Text }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, and the conventions that go with it: number and date formats, the alphabetical order of text columns and the default CSV separator. The default is `Locale.default`, which is English; see [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "searchable", type_ = "Flag", description = "Adds a search box to the toolbar. Every word the user types must be found in one of the visible, searchable columns (case and accents are ignored), and the match is highlighted. Escape clears the box and is used up (its default is prevented, so a dialog that closes only on an Escape nothing inside took stays open); an Escape in the empty box is lef", control = Choice [ "Enabled", "omit" ] }
            , { name = "searchPlaceholder", type_ = "String", description = "The placeholder of the search box. It also turns the search box on. The default tells how many rows can be searched, as in \"Search 120 rows ...\", and is just \"Search ...\" in server mode.", control = Text }
            , { name = "searchDebounce", type_ = "Int", description = "Milliseconds to wait after typing before what was typed in the search box, the text filters and the number range filters takes effect (checkbox filters always apply at once). The default is 0 in client mode and 350 in server mode, so that a server is not asked on every key press.", control = Number }
            , { name = "rowFilter", type_ = "(row -> Bool)", description = "Client mode: an extra filter from outside the table, such as a [Klar.FilterBar](Klar-FilterBar) or a [Klar.RuleBuilder](Klar-RuleBuilder). Rows for which it returns `False` are left out, on top of the table's own search and filters. Tell the table how many outside filters are active with `activeExternalFilters`; server mode ignores this one, as you", control = Example }
            , { name = "activeExternalFilters", type_ = "Int", description = "How many filters outside the table are active (the ones behind `rowFilter`, or the ones you send to your backend). The table uses the number to tell \"no matches\" (a filter hides the rows) from \"no data\". It draws nothing for them: the \"N filters active\" button counts the column filters of the table only, because outside filters have a display of th", control = Number }
            , { name = "onResetFilters", type_ = "msg", description = "The message to send when the user clicks one of the table's reset buttons: the cross and \"Reset filters\" in the filter summary, which clear the column filters and keep the search text, and \"Clear search and filters\" in the \"No matches\" state, which clears both. When your message arrives the table has cleared its own filters (and maybe the search), ", control = Example }
            , { name = "selectable", type_ = "Flag", description = "Adds a checkbox column, a \"select all on this page\" checkbox in the header, and a bar that covers the toolbar while something is selected (see `bulkActions`). Needs `rowId`: without it there are no checkboxes at all, because a selection kept by position would point at other rows after a sort. Space selects the focused row, and rows that are `rowDis", control = Choice [ "Enabled", "omit" ] }
            , { name = "bulkActions", type_ = "List (Html msg)", description = "Buttons for the bar that covers the toolbar while rows are selected, next to the count, the export menu and a Cancel button that clears the selection. Your buttons send plain messages: read `selection` in your update, which is `AllMatching { except }` after \"Select all N matching\" in server mode (then `selectedIds` is `[]`). Use small buttons; it a", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "rowActions", type_ = "(row -> List (Menu.Item msg))", description = "A \"more\" menu at the end of every row, made of [Klar.Menu](Klar-Menu) items. Return `[]` for rows without actions. The menu buttons are one tab stop for the whole table (the arrow keys move between rows), and Shift+F10 or the menu key on a row opens its menu. On a `rowDisabled` row the button is disabled and no key opens the menu.", control = Example }
            , { name = "onRowClick", type_ = "(row -> msg)", description = "The message to send for a row, when the user clicks it (outside its own controls) or presses Enter on it. The function gets the row. A row that is `rowDisabled` does not send it.", control = Example }
            , { name = "currentRow", type_ = "(row -> Bool)", description = "Marks the row whose details are shown elsewhere, such as the order open in a drawer next to the table: it gets a bar at its start and a darker background, and screen readers hear it as the current row (`aria-current`). Return `True` for at most one row; without this attribute no row is marked.", control = Example }
            , { name = "expandedRow", type_ = "(row -> Html msg)", description = "Lets rows expand to show more under them: adds an arrow button at the start of each row and draws `render row` in a full-width cell below an open row. ArrowRight and ArrowLeft expand and collapse the focused row, and without `onRowClick` a click on the row toggles it too; a `rowDisabled` row does none of this. Which rows are open is part of the sta", control = Example }
            , { name = "rowTone", type_ = "(row -> Maybe Tone)", description = "A colored accent at the start of some rows: return a `Tone` (from [Klar.Theme](Klar-Theme)) for the rows that need one and `Nothing` for the rest.", control = Example }
            , { name = "rowDisabled", type_ = "(row -> Bool)", description = "Rows that are shown but cannot be operated. A disabled row is dimmed and marked `aria-disabled`; its checkbox, expand button and actions button are disabled, so Tab skips them, and it is left out of \"select all\". A click, Enter, Space, ArrowRight, ArrowLeft, Shift+F10 or the menu key on the row does nothing, but the keys that move between rows (Arr", control = Example }
            , { name = "toolbarActions", type_ = "List (Html msg)", description = "Your own buttons at the right end of the toolbar, next to the table's own tools.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "onRefresh", type_ = "msg", description = "Adds a refresh button to the toolbar that sends this message. The button shows a spinner while the rows are refreshing (`Remote.refresh`) or loading.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "The message to send when the user clicks \"Try again\" in the error state, which shows when `remote` is a `Failed`. Without it there is no button, and the button only appears for problems worth retrying (see `Remote.isRetryable` in [Klar.Remote](Klar-Remote)). Keyboard focus stays in the table while the new rows load.", control = Example }
            , { name = "exportCsv", type_ = "String", description = "Adds an \"Export\" menu to the toolbar (and to the bar that shows while rows are selected) that downloads the visible columns as a CSV file. The `String` is the file name, used as given (`\"orders.csv\"`).", control = Text }
            , { name = "csvSeparator", type_ = "Char", description = "The field separator of the CSV export. The default is a comma in English and a semicolon in Norwegian, where spreadsheets use the comma as the decimal separator.", control = Text }
            , { name = "columnChooser", type_ = "Flag", description = "Adds a \"Columns\" button to the toolbar that opens a list of checkboxes to hide and show columns, with Reset and Done buttons. Columns that are `alwaysVisible`, and the last visible column, cannot be hidden. The choices are part of the state (see `isColumnVisible` and `setColumnVisible`).", control = Choice [ "Enabled", "omit" ] }
            , { name = "densityToggle", type_ = "Flag", description = "Adds three buttons to the toolbar to choose the row height: compact, normal or comfortable. The choice is part of the state (see `density` and `setDensity`).", control = Choice [ "Enabled", "omit" ] }
            , { name = "pageSizes", type_ = "List Int", description = "The choices of the \"Rows per page\" selector in the footer. The default is `[ 10, 25, 50, 100 ]`. The page size itself is part of the state (25 from `init`; see `pageSize` and `setPageSize`).", control = Text }
            , { name = "rangeText", type_ = "(Int -> Int -> Int -> String)", description = "Words the range in the footer yourself (\"1–25 of 200\" is the default): the first and last row shown and the number of matching rows in, the text out. Format the numbers with [Klar.Format](Klar-Format). It is also the range of a `virtual` table (\"1 to 24 of 50,000\"); the announcement for screen readers keeps its own words. Works the same in `ServerL", control = Example }
            , { name = "unpaged", type_ = "Flag", description = "All rows on one page and no pagination footer. Every matching row is turned into HTML, so keep it for short tables.", control = Choice [ "Enabled", "omit" ] }
            , { name = "virtual", type_ = "Flag", description = "Shows the rows in one long list that scrolls, instead of in pages, and draws only the rows that are in view. Use it for tables with thousands of rows that people read by scrolling; a table that people page through, or whose rows differ in height, is better with pages (see \"Paging or scrolling\" at the top).", control = Choice [ "Enabled", "omit" ] }
            , { name = "multiSort", type_ = "Flag", description = "Lets the user sort by several columns: Shift-clicking a header adds that column as the next sort level (or cycles its direction in place), and the headers show the order as small numbers. A plain click sorts by that column only; without `multiSort`, Shift changes nothing.", control = Choice [ "Enabled", "omit" ] }
            , { name = "zebra", type_ = "Flag", description = "Gives every second row a light gray background.", control = Choice [ "Enabled", "omit" ] }
            , { name = "maxHeight", type_ = "Int", description = "The rows scroll inside this height in pixels, under a header that stays in view. Without it the table is as tall as its rows.", control = Number }
            , { name = "fillHeight", type_ = "Flag", description = "The table fills the height of its parent, which must have a height of its own, and the rows scroll inside under the header. For the rest of the page under a heading, put the table in a `Layout.stack [ Layout.fillRest ]` (inside an `AppShell` that is the height of the window under the top bar).", control = Choice [ "Enabled", "omit" ] }
            , { name = "emptyState", type_ = "List (EmptyState.Attribute msg)", description = "Changes the empty state shown when there are no rows at all (titled \"No data\" by default). The \"No matches\" state for a search or filter that hides every row is built in and not affected; its \"Clear search and filters\" button clears the search and the column filters, and sends your `onResetFilters` message. The attributes are those of [Klar.EmptySt", control = Example }
            ]

        "Budget" ->
            [ { name = "title", type_ = "String", description = "Heading for the sheet. Defaults to the localized word \"Budget\".", control = Text }
            , { name = "totalLabel", type_ = "String", description = "Label for the grand total. Defaults to \"Total budget\".", control = Text }
            , { name = "readOnly", type_ = "Bool", description = "Show values and calculations without inputs or add/remove actions.", control = Choice [ "True", "False" ] }
            , { name = "locale", type_ = "Locale", description = "Language and price parsing conventions; defaults to English.", control = Choice [ "en", "nb" ] }
            ]

        "Pagination" ->
            [ { name = "onPage", type_ = "(Int -> msg)", description = "The message to send when the user chooses a page, with the page number. It is 1-based and always valid: between 1 and the last page. It is sent by the page buttons, by first / previous / next / last, and by \"Go to page\". Without `onPage` the buttons do nothing.", control = Example }
            , { name = "onPageSize", type_ = "(Int -> msg)", description = "Shows the \"Rows per page\" choice (full variant only) and sends the new size when the user picks one. The sizes on offer come from `pageSizes`. The current page may no longer exist with a new size, so change `page` too, usually back to 1.", control = Example }
            , { name = "pageSizes", type_ = "List Int", description = "The sizes offered in the \"Rows per page\" choice. The default is `[ 10, 25, 50, 100 ]`. The current page size is always offered, even if it is not in the list. Sizes below 1 are dropped.", control = Text }
            , { name = "compact", type_ = "Flag", description = "Only the range and previous / next: \"1–25 of 3,000 ‹ ›\". For narrow places like cards and side panels. The compact variant has no page numbers, no \"Rows per page\" choice and no \"Go to page\".", control = Choice [ "Enabled", "omit" ] }
            , { name = "jumpToPage", type_ = "Flag", description = "Adds a \"Go to page\" number input after the page buttons. It is shown in the full variant when there is more than one page and an `onPage` message. The user types a page and presses Enter (or leaves the field); a number outside the range goes to the nearest page.", control = Choice [ "Enabled", "omit" ] }
            , { name = "siblings", type_ = "Int", description = "How many page numbers to show on each side of the current page. The default is 1.", control = Number }
            , { name = "disabled", type_ = "Bool", description = "While `True` no control does anything, for example while a page is loading. The default is `False`. The controls are marked `aria-disabled` and dimmed, but they stay in the tab order and keep the keyboard focus: the Next button that the user just pressed is still focused when the page has loaded.", control = Choice [ "True", "False" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the navigation. The default is `\"klar-pagination\"`. The \"Rows per page\" select and the \"Go to page\" input get ids derived from it (`order-pages-size` and `order-pages-jump`), so give every pagination on a page its own id.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the navigation landmark, heard by screen readers only. The default is \"Pagination\" (in the language of `locale`). Name it more closely when a page has several paginations, such as \"Orders pages\".", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the range, \"Rows per page\", the button labels and \"Go to page\", with numbers grouped the way the language does it. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "summary", type_ = "List (Html msg)", description = "Replaces the range text (\"1–25 of 3,000\") with your own content, for example a \"Loading ...\" message while a page is on its way, or nothing (an empty list) when the range would describe rows that are not on screen. The controls stay.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "rangeText", type_ = "(Int -> Int -> Int -> String)", description = "Words the range yourself: the first and last item of the page and the total in, the text out. The default is \"1–25 of 3,000\" (\"1–25 av 3 000\" in Norwegian). It is not called when there is nothing to count, and `summary` wins over it.", control = Example }
            ]

        "ListItem" ->
            [ { name = "secondary", type_ = "String", description = "A second line under the title, in gray: a customer, an address or a short description.", control = Text }
            , { name = "meta", type_ = "String", description = "Small gray text at the right end of the row: a date, a count or a status. The digits are tabular, so numbers line up from row to row.", control = Text }
            , { name = "icon", type_ = "Icon", description = "An icon in a quiet box in front of the title.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "avatar", type_ = "String", description = "An avatar for this name in front of the title. The avatar is decorative (hidden from screen readers), so the name should also be in the text of the row.", control = Text }
            , { name = "leading", type_ = "Html msg", description = "Anything else in front of the title, such as a thumbnail. It sits inside the button or link of the row, so it should not contain buttons or links of its own: use `trailing` for those.", control = Text }
            , { name = "trailing", type_ = "List (Html msg)", description = "Buttons, menus or badges at the end of the row. They are separate controls: clicking them does not click the row.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "selected", type_ = "Bool", description = "Marks the current row of a master list: tinted, with a bar at the left, and `aria-current` for screen readers. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "disabled", type_ = "Bool", description = "Visible but dimmed and not clickable: `onClick` and `href` are ignored, and the row is marked `aria-disabled`. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "onClick", type_ = "msg", description = "Makes the row a button that sends this message when it is clicked or activated with the keyboard. If the row also has an `href`, it is a link, and the message is sent when the link is followed with a plain click: the main mouse button or the keyboard, without Ctrl, Cmd, Shift or Alt. A click that opens the link elsewhere sends nothing, and the link", control = Example }
            , { name = "href", type_ = "String", description = "Makes the row a link to this URL. Use `#/path` for links inside a single page application. If the row also has an `onClick` message, it is sent when the link is followed with a plain click (see `onClick`).", control = Text }
            , { name = "accent", type_ = "Tone", description = "A colored strip at the left edge: a status the user should see in a long list. `Neutral` is gray, `Primary` and `Info` are blue, and `Success`, `Warning` and `Danger` have colors of their own. A color says nothing to a screen reader, so the status must also be in the text of the row (the `meta` or the `secondary` line); in the high-contrast mode of", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the row. A row with `onClick` or `href` puts it on its button or link, the element that takes the focus, so `Klar.focus` with this id brings the keyboard back to the row (after a delete or a retry); any other row puts it on its `li`.", control = Text }
            , { name = "rowAriaLabel", type_ = "String", description = "An accessible name (`aria-label`) for the button or link of the row, which only screen readers hear. It replaces the text of the row when a screen reader reads it, so use it only when the title and the secondary text would not make sense out of context. A row that is neither a button nor a link (it has no `onClick` or `href`) is plain content and i", control = Text }
            ]

        "Tree" ->
            [ { name = "ariaLabel", type_ = "String", description = "The accessible name of the tree, for example \"Warehouses\". Give every tree on a page its own name.", control = Text }
            , { name = "multiSelect", type_ = "Flag", description = "Several nodes can be selected: `Ctrl` or `Cmd`+click toggles a node, `Shift`+click selects a range of the visible nodes (nodes that are `disabled` are skipped), `Shift` with an arrow, `PageUp`, `PageDown`, `Home` or `End` extends the range, `Ctrl`+`A` (`Cmd`+`A`) selects every visible node, and `Space` toggles. Read the result with `selectedIds`. I", control = Choice [ "Enabled", "omit" ] }
            , { name = "allowEmptySelection", type_ = "Flag", description = "A click on the selected node (or `Space`, or `Enter` without `onActivate`) selects nothing, so the selection can go back to \"no node\", the normal state of a tree that filters something else (\"all locations\"). Without it a selected node stays selected until another is chosen (or `setSelectedIds` with no ids clears it). In a `multiSelect` tree a plai", control = Choice [ "Enabled", "omit" ] }
            , { name = "checkboxes", type_ = "Flag", description = "A tri-state checkbox on every node. Checking a parent checks all the leaves below it; a parent with some of them checked shows a dash. A click anywhere on a row toggles its checkbox, and so do `Space` and (without `onActivate`) `Enter`. Rows are not highlighted as selected in this mode. Lazy nodes can be checked once their children have loaded. A `", control = Choice [ "Enabled", "omit" ] }
            , { name = "filterBox", type_ = "Flag", description = "A search field above the tree that filters it as the user types. The nodes whose label, description or keywords contain every typed word are kept, together with their ancestors (which are opened), and the matching text of the label and the description is highlighted. A hidden status line tells screen readers how many nodes match. The text is part o", control = Choice [ "Enabled", "omit" ] }
            , { name = "filterPlaceholder", type_ = "String", description = "The placeholder of the filter box. The default is \"Search the tree ...\".", control = Text }
            , { name = "onActivate", type_ = "(id -> msg)", description = "The message to send, given the node id, when the user presses `Enter` on a node or double-clicks it: open the record, navigate. Without it `Enter` selects and a double click opens or closes. Nodes that are `disabled` are not activated.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button of `viewRemote`: when the top level failed to load, and in the \"Old data from 14:05\" marker when a refresh of it failed. The button is only shown when the problem is worth retrying (see `Klar.Remote.isRetryable`). The tree moves the keyboard focus to its filter box, or to the element with the id of `init`,", control = Example }
            , { name = "onRetryChildren", type_ = "(id -> msg)", description = "The message to send, given the node id, when the user presses \"Try again\" on a lazy node whose children failed to load (or in its \"Old data\" marker when a refresh of them failed). The button is only shown when the problem is worth retrying (see `Klar.Remote.isRetryable`). Set the children to `Loading` again (or `Remote.refresh` them) and fetch them", control = Example }
            , { name = "compact", type_ = "Flag", description = "Shorter rows (24px instead of 28px): for dense layouts and side panels. A tree in an application with a compact density (`Klar.Settings`) is already compact; this makes just this tree compact.", control = Choice [ "Enabled", "omit" ] }
            , { name = "maxHeight", type_ = "Int", description = "Makes the tree scroll inside itself when it is taller than this many pixels. The filter box stays above the scrolling part. Default: no limit.", control = Number }
            , { name = "maxChildren", type_ = "Int", description = "How many children of one node are rendered before a \"Show N more\" row. The default is 300; the value is kept between 10 and 10000. Each press on the row shows up to that many more and moves the keyboard focus to the first new row.", control = Number }
            , { name = "emptyState", type_ = "List (EmptyState.Attribute msg)", description = "Changes the empty state shown when there are no nodes at all (titled \"No nodes\" by default, with a folder icon). The attributes are those of [Klar.EmptyState](Klar-EmptyState), applied after the built-in ones, so yours win. While a filter matches nothing the tree says \"No matches\" instead, which this does not change.", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (the filter box, \"Loading ...\", \"Try again\", \"No items\", \"No matches\", \"Show N more\", \"Old data\") and of the numbers. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "CardList" ->
            [ { name = "id", type_ = "String", description = "A DOM id unique on the page and a stable focus target after retry or removal. Absent by default. Use `Klar.focus` in the handler when its control disappears.", control = Text }
            , { name = "selection", type_ = "List id -> (List id -> msg)", description = "Enables selection, with the selected ids and the callback receiving the new complete selection. Clearing loaded cards keeps ids from other pages.", control = Example }
            , { name = "onOpen", type_ = "(id -> msg)", description = "Turns each title into a button that sends its record's id. Absent by default.", control = Example }
            , { name = "actions", type_ = "(record -> List (Html msg))", description = "Additional controls below each card's fields. Empty by default.", control = Example }
            , { name = "onLoadMore", type_ = "msg", description = "Shows a load-more button after the loaded cards. The application appends data.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry message for initial failures and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Settings used to format the time of retained data. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "WorkQueue" ->
            [ { name = "searchable", type_ = "Flag", description = "Adds a search field for loaded titles and summaries. Off by default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "onLoadMore", type_ = "msg", description = "Adds a load-more button. The application appends or replaces the loaded page.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry for initial failures and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Formatting of retained-data timestamps. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "Modal" ->
            [ { name = "subtitle", type_ = "String", description = "A smaller line below the title, for context such as the order number.", control = Text }
            , { name = "small", type_ = "Flag", description = "400px wide, for a short question or a field or two.", control = Choice [ "Enabled", "omit" ] }
            , { name = "medium", type_ = "Flag", description = "560px wide. This is the default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "large", type_ = "Flag", description = "800px wide, for wide forms and tables.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "Sets the width from a [`Size`](Klar-Theme#Size): `Small` (400px), `Medium` (560px, the default) or `Large` (800px). `small`, `medium` and `large` are shorthands. A [Klar.Drawer](Klar-Drawer) is 360, 480 or 720px wide instead.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "fullHeight", type_ = "Flag", description = "The dialog is as tall as the window (less a small margin) instead of only as tall as its content. For long forms and lists. It stays in the middle of the window; a panel along its side is a [Klar.Drawer](Klar-Drawer).", control = Choice [ "Enabled", "omit" ] }
            , { name = "static", type_ = "Flag", description = "A click on the backdrop and `Escape` do not close the dialog; the close button still does. The dialog gives a small nudge instead, so that it does not feel frozen. For forms with unsaved data.", control = Choice [ "Enabled", "omit" ] }
            , { name = "busy", type_ = "Bool", description = "While `True` nothing can close the dialog: the close button is disabled and the backdrop and `Escape` are ignored. The dialog also announces `aria-busy`. Pass a field of your model that is `True` while a request runs.", control = Choice [ "True", "False" ] }
            , { name = "onRequestClose", type_ = "msg", description = "Send this message instead of closing. The close button, `Escape` and the backdrop then send `msg` and the dialog stays open; the application decides, and calls `Modal.close` when it is fine to go (after asking \"Discard changes?\", say). A `static` dialog sends `msg` only from its close button.", control = Example }
            , { name = "footerStart", type_ = "List (Html msg)", description = "Content at the left end of the footer, opposite the actions: a note, a checkbox, a \"Delete order\" link. Giving it also shows the footer.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "footer", type_ = "List (Html msg)", description = "The actions, right aligned in a fixed footer at the bottom of the dialog. The primary action goes last. The footer is only shown when `footer` or `footerStart` is given.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "flush", type_ = "Flag", description = "No padding around the body, for tables and lists that go edge to edge.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hideClose", type_ = "Flag", description = "Do not show the close button in the header. `Escape` and the backdrop still close the dialog unless it is `static`, so give the user another way out, such as a \"Cancel\" button in the footer.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaDescribedBy", type_ = "String", description = "The id of an element inside the dialog that describes it (a paragraph of explanation, say). Screen readers read it out after the title.", control = Text }
            , { name = "lastFocus", type_ = "String", description = "The id of the element that `Shift+Tab` on the first element of the dialog wraps around to, usually the primary button. Without it focus lands at the end of the footer (or of the body when there is no footer), and the next `Shift+Tab` reaches the last button.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the label of the close button (\"Close\" by default). The default language is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "ConfirmDialog" ->
            [ { name = "message", type_ = "String", description = "A short explanation in plain text, below the question: \"Order 1042 will be removed from all lists.\" Screen readers read it out after the title.", control = Text }
            , { name = "body", type_ = "List (Html msg)", description = "Rich content below the message: a name in bold, a link, a small table.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "consequences", type_ = "List String", description = "What will happen, one short line each, shown as a bulleted list below the message: \"3 open shipments are canceled\".", control = Text }
            , { name = "tone", type_ = "Tone", description = "The tone of the question (a [`Tone`](Klar-Theme#Tone)): `Neutral`, the default, is a question with no risk (a blue help icon and a blue confirm button); `Warning` an action that is hard to undo or that affects others (a warning icon, the confirm button stays blue); `Danger` a destructive action (a red error icon and a red confirm button). `Info` an", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "icon", type_ = "Icon", description = "Replaces the icon of the tone with another one, for example `ConfirmDialog.icon Icon.trash`.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "confirmLabel", type_ = "String", description = "Text of the confirm button. The default is \"Confirm\" (it follows `locale`). Name the action instead: \"Delete order\".", control = Text }
            , { name = "cancelLabel", type_ = "String", description = "Text of the cancel button. The default is \"Cancel\" (it follows `locale`).", control = Text }
            , { name = "confirmDisabled", type_ = "Bool", description = "Disables the confirm button (and `Enter` in the typed-confirmation field) while `True`: pass a field of your model that is `False` until the user has made the choice the question needs. The dialog stays calm about it: no message is shown, so say what is missing beside the control (a `Select.errorMaybe`, say). If the confirm button has focus when it", control = Choice [ "True", "False" ] }
            , { name = "typeToConfirm", type_ = "String", description = "The user must type this text before the confirm button is enabled, for actions that cannot be undone: a word that makes them stop and read, such as `\"DELETE\"` or the name of the thing they delete. The field is labeled \"Type DELETE to confirm\" (it follows `locale`), and `Enter` in it confirms once the text matches. Matching is exact, apart from spac", control = Text }
            , { name = "ignoreCase", type_ = "Flag", description = "For `typeToConfirm`: \"delete\" matches \"DELETE\".", control = Choice [ "Enabled", "omit" ] }
            , { name = "onConfirm", type_ = "msg", description = "The message sent when the user confirms: with the confirm button, with `Enter` in the typed-confirmation field, or with the \"Try again\" button after a failure. Nothing is sent until the typed text matches. Your `update` then calls `setBusy` and starts the request.", control = Example }
            , { name = "onCancel", type_ = "msg", description = "The message sent when the user cancels in any way: with the cancel button, the close button, `Escape` or the backdrop. Your `update` then calls `close` and clears what was being confirmed. Give it whenever your model keeps that (a pending order, an id): without `onCancel` the dialog closes itself, and your model would keep the stale value. It is no", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the buttons (\"Confirm\" and \"Cancel\"), the \"Try again\" button, the label of the typed-confirmation field and the label of the close button. The default is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Drawer" ->
            [ { name = "subtitle", type_ = "String", description = "A smaller line below the title, for context such as the date of the last change.", control = Text }
            , { name = "small", type_ = "Flag", description = "360px wide.", control = Choice [ "Enabled", "omit" ] }
            , { name = "medium", type_ = "Flag", description = "480px wide. This is the default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "large", type_ = "Flag", description = "720px wide.", control = Choice [ "Enabled", "omit" ] }
            , { name = "right", type_ = "Flag", description = "Slide in from the right edge. This is the default. Only `Drawer.view` reads it: `Modal.view` draws a centered dialog whatever you pass.", control = Choice [ "Enabled", "omit" ] }
            , { name = "left", type_ = "Flag", description = "Slide in from the left edge. Only `Drawer.view` reads it: `Modal.view` draws a centered dialog whatever you pass.", control = Choice [ "Enabled", "omit" ] }
            , { name = "static", type_ = "Flag", description = "A click on the backdrop and `Escape` do not close the drawer; the close button still does. Use it for a drawer with a form, so that unsaved input is not lost by a stray click. The drawer gives a small nudge instead, so that it does not feel frozen.", control = Choice [ "Enabled", "omit" ] }
            , { name = "busy", type_ = "Bool", description = "While `True` nothing can close the drawer: the close button is disabled and the backdrop and `Escape` are ignored. Pass a field of your model that is `True` while a request runs.", control = Choice [ "True", "False" ] }
            , { name = "onRequestClose", type_ = "msg", description = "Send this message instead of closing. The close button, `Escape` and the backdrop then send `msg` and the drawer stays open; the application decides, and calls `close` when it is fine to go (after asking \"Discard changes?\", say).", control = Example }
            , { name = "footer", type_ = "List (Html msg)", description = "The actions, right aligned in a fixed footer at the bottom of the drawer. The primary action goes last. The footer is only shown when `footer` or `footerStart` is given.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "footerStart", type_ = "List (Html msg)", description = "Content at the left end of the footer, opposite the actions: a note, a checkbox, a \"Delete order\" link.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "flush", type_ = "Flag", description = "No padding around the body, for tables and lists that go edge to edge.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hideClose", type_ = "Flag", description = "Do not show the close button in the header. `Escape` and the backdrop still close the drawer unless it is `static`, so give the user another way out, such as a \"Close\" button in the footer.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaDescribedBy", type_ = "String", description = "The id of an element inside the drawer that describes it, such as a paragraph of explanation. Screen readers read it out after the title.", control = Text }
            , { name = "lastFocus", type_ = "String", description = "The id of the element that `Shift+Tab` on the first element of the drawer wraps around to, usually the primary button. Without it focus lands at the end of the footer (or of the body when there is no footer), and the next `Shift+Tab` reaches the last button.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the label of the close button (\"Close\" by default). The default language is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Toast" ->
            [ { name = "tone", type_ = "Tone", description = "The tone of the toast (a [`Tone`](Klar-Theme#Tone)). It sets the icon, the color of the accent and how long the toast stays on screen: `Info`, the default, is a plain notice with a blue accent (5 seconds); `Success` something that went well, with a green accent and a check mark (4 seconds); `Warning` something that needs attention, with an amber ac", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "title", type_ = "String", description = "A bold first line above the message.", control = Text }
            , { name = "message", type_ = "String", description = "The text of the toast. It is empty by default, so give a `message`, a `title` or both.", control = Text }
            , { name = "action", type_ = "String -> msg", description = "One button, usually \"Undo\". A click sends the message and dismisses the toast. A toast with an action stays at least 8 seconds, unless you set `duration` or `sticky`.", control = Example }
            , { name = "key", type_ = "String", description = "Names the toast, so that the application can take it away from `update` with `dismiss`, and so that a new toast with the same key replaces the old one instead of stacking next to it (a second failed save shows one toast, not two).", control = Text }
            , { name = "duration", type_ = "Int", description = "Dismiss after this many milliseconds, whatever the tone. The timer stops while the pointer is over the toast or focus is inside it.", control = Number }
            , { name = "sticky", type_ = "Flag", description = "Stays until the user closes it, whatever the tone.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "For `view`: the language of the built-in text, which is the label of the stack for screen readers (\"Notifications\"), the note \"+ 2 more waiting\" and the label of the close buttons (\"Dismiss notification\"). `push` ignores it. The default is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Popover" ->
            [ { name = "icon", type_ = "Icon", description = "An icon on the button, before the label.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "iconOnly", type_ = "Flag", description = "The button shows only its icon (three dots if you give no `icon`), and the label of `view` becomes its accessible name.", control = Choice [ "Enabled", "omit" ] }
            , { name = "trigger", type_ = "List (Button.Attribute msg)", description = "Style the button: `Popover.trigger [ Button.ghost, Button.small ]`. The attributes add up when you use it more than once. It has no effect with `customTrigger`.", control = Example }
            , { name = "customTrigger", type_ = "(List (Html.Attribute msg) -> Html msg)", description = "Use your own element as the button. The function receives the attributes it must put on that element (`id`, `aria-haspopup`, `aria-expanded`, the click handler and the `ArrowDown` handler); without them the panel cannot open and focus cannot return to the element. Your element shows its own text; the label of `view` still names the panel when it ha", control = Example }
            , { name = "title", type_ = "String", description = "A heading in the panel; it is also the accessible name of the panel, instead of the label.", control = Text }
            , { name = "closeButton", type_ = "Flag", description = "A close button in the header of the panel. Its label follows `locale`. The header is shown when the panel has a `title` or a close button.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignEnd", type_ = "Flag", description = "Align the right edge of the panel with the right edge of the button, so that the panel extends to the left. Use it for a button near the right edge of the window.", control = Choice [ "Enabled", "omit" ] }
            , { name = "width", type_ = "Int", description = "Width of the panel in pixels. The default is 320. The panel is never wider than 520px or the window.", control = Number }
            , { name = "noPadding", type_ = "Flag", description = "No padding around the content, for lists and tables that go edge to edge. Content taller than 70% of the window (at most 520px) scrolls.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the label of the close button (\"Close\" by default). The default language is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "ContextMenu" ->
            [ { name = "ariaLabel", type_ = "String", description = "The name of the menu that a screen reader says when it opens, such as \"Order actions\". The default is \"Actions\" (in the language of `locale`).", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the default name of the menu. The default is `Locale.default`, which is `Locale.en`; the items are your own text.", control = Choice [ "en", "nb" ] }
            ]

        "CommandPalette" ->
            [ { name = "sections", type_ = "List (Section msg)", description = "The sections, in the order they are shown. The default is none.", control = Example }
            , { name = "recent", type_ = "List (Item msg)", description = "Items shown first, under the heading \"Recent\", while the query is empty: the commands the user ran last, for example. The default is none.", control = Example }
            , { name = "placeholder", type_ = "String", description = "The hint in the empty search box. The default is \"Search commands and content ...\".", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the dialog and of its list, which only a screen reader hears. The default is \"Command palette\".", control = Text }
            , { name = "emptyText", type_ = "String", description = "The text shown when nothing matches at all, and what an empty remote section says unless it has a `withEmptyText` of its own. The default is \"No results\".", control = Text }
            , { name = "platform", type_ = "Kbd.Platform", description = "The keyboard to write the shortcuts of the items for, as in [Klar.Kbd](Klar-Kbd): `Kbd.pc` (the default: Ctrl, Alt, Shift) or `Kbd.mac` (⌘, ⌥, ⇧). Read it once from the user agent with `Kbd.platformFromUserAgent`. [Klar.Shortcut](Klar-Shortcut) finds a Mac by itself, a view cannot: without this a Mac user reads \"Ctrl K\" for a shortcut that fires on", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in texts: the placeholder, the footer, the heading of the recent items, the spoken names of the keys and the announcement of the number of results. The default is `Locale.default`, which is `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "ShortcutHelp" ->
            [ { name = "title", type_ = "String", description = "The heading of the dialog, which is also its accessible name. The default is \"Keyboard shortcuts\".", control = Text }
            , { name = "platform", type_ = "Kbd.Platform", description = "The keyboard to write the keys for, as in [Klar.Kbd](Klar-Kbd): `Kbd.pc` (the default: Ctrl, Alt, Shift) or `Kbd.mac` (⌘, ⌥, ⇧ in the order a Mac writes them). Read it once from the user agent with `Kbd.platformFromUserAgent`. [Klar.Shortcut](Klar-Shortcut) finds a Mac by itself, a view cannot: without this a Mac user reads \"Ctrl K\" for a shortcut ", control = Example }
            , { name = "extra", type_ = "List { group : String, label : String, keys : Shortcut.Keys }", description = "Keys worth knowing that are not shortcuts of the application: the keys of Klar's own components (`Shift+F10` for the menu of a row, `Enter` to edit a cell) or of your own widgets. They are listed under their group like the shortcuts, after them, and found by the filter, but never listened to. The default is none.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in texts: the heading, the filter box, the notes, the spoken names of the keys and the Close button. The default is `Locale.default`, which is `Locale.en`. The groups and labels of the shortcuts come from the application.", control = Choice [ "en", "nb" ] }
            ]

        "AppShell" ->
            [ { name = "id", type_ = "String", description = "A DOM id for the shell, unique on the page, for a shell without a `State` (with one, the id is the one given to `init`, and `state` sets it). Default `klar-app-shell`. Pass the same id to `focusContent`, `focusMenuButton` and `resetScroll`; the content area, the sidebar, the search button and the menu button get ids made of it plus a suffix: `-cont", control = Text }
            , { name = "brand", type_ = "Html msg", description = "The product name or logo at the left of the top bar, after the sidebar toggle. Usually the result of `brandLink`; any Html will do. On a shell narrower than 430px the name of a `brandLink` that has a logo is hidden and only the logo is left.", control = Text }
            , { name = "sidebar", type_ = "Html msg", description = "The content of the sidebar, normally a `SideNav.view` from [Klar.SideNav](Klar-SideNav), with anything else you want in it (a caption, a filter tree). The sidebar is an `aside` landmark named \"Sidebar\" (\"Sidepanel\" in Norwegian), so everything in it is inside a landmark; the `SideNav` is its own `nav` inside it. The sidebar scrolls on its own when ", control = Text }
            , { name = "sidebarCollapsed", type_ = "Bool", description = "Only for a shell without `AppShell.state` (`isSidebarCollapsed` and `setSidebarCollapsed` are the way with one). Collapses the sidebar to a narrow strip of icons when the shell is 900px wide or more (default `False`). Pass the same flag to `SideNav.collapsed`, so that the menu itself draws icons only, and flip it in your model when `onToggleSidebar", control = Choice [ "True", "False" ] }
            , { name = "onToggleSidebar", type_ = "msg", description = "Only for a shell without `AppShell.state`, which sends its own message. Sent by the sidebar toggle in the top bar on wide shells (900px or more). Its accessible name is \"Hide the sidebar\" or \"Show the sidebar\", and `aria-expanded` follows `sidebarCollapsed`. Without `onToggleSidebar` there is no toggle there and the sidebar keeps its size; the menu", control = Example }
            , { name = "drawerOpen", type_ = "Bool", description = "Only for a shell without `AppShell.state` (`isDrawerOpen` and `closeDrawer` are the way with one). Whether the sidebar drawer is open (default `False`). It only matters on narrow shells, below 900px; on wide ones the sidebar is always in place. Set it in your model when `onToggleDrawer` arrives, and clear it on `onCloseDrawer` and when the route ch", control = Choice [ "True", "False" ] }
            , { name = "onToggleDrawer", type_ = "msg", description = "Only for a shell without `AppShell.state`, which sends its own message. Sent by the menu button (\"Menu\") in the top bar on narrow shells (below 900px), the only way to open the drawer; its `aria-expanded` follows `drawerOpen`. If you give only `onToggleSidebar`, that message is used there too. The button also sends it when the drawer is open, so on", control = Example }
            , { name = "onCloseDrawer", type_ = "msg", description = "Only for a shell without `AppShell.state`, which sends its own message. Sent when the open drawer should close: a click on the backdrop, or Escape pressed while the drawer is open and focus is in the top bar, the sidebar or the content (an Escape that a control inside used already, such as an open popup closing, does not count). Without it the back", control = Example }
            , { name = "onSearch", type_ = "msg", description = "Shows the global search field in the middle of the top bar and sends the message when it is clicked. It is a button that looks like a search field, so connect it to whatever opens your search, such as a command palette; the keyboard shortcut belongs to the application (see [Klar.Shortcut](Klar-Shortcut)). On narrow shells the field shrinks to an ic", control = Example }
            , { name = "searchPlaceholder", type_ = "String", description = "The text in the search field, which is also its accessible name. Default \"Search ...\" (in the language of `locale`).", control = Text }
            , { name = "searchShortcut", type_ = "List String", description = "The key caps shown at the right of the search field. Default `[ \"Ctrl\", \"K\" ]`; an empty list shows none. They only describe the shortcut (also in the tooltip and in `aria-keyshortcuts`): the shell does not listen for the keys, so bind them yourself with [Klar.Shortcut](Klar-Shortcut).", control = Text }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons at the right of the top bar, before the user: a language switch, help, notifications. Pass small, quiet buttons, for example `Button.iconOnly [ Button.ghost, Button.onClick OpenHelp ] Icon.help \"Help\"`.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "userName", type_ = "String", description = "The name of the signed-in user, shown at the right end of the top bar next to a circle with the initials (the first letters of the first and last word: \"Ada Lovelace\" gives \"AL\"). Use `userAvatar` to replace the circle. On shells 640px wide or less only the circle is shown.", control = Text }
            , { name = "userRole", type_ = "String", description = "A line of small gray text under the user's name, such as a role or the name of the organization. It is only shown together with `userName`.", control = Text }
            , { name = "userAvatar", type_ = "Html msg", description = "Your own avatar, such as a photo or a [Klar.Avatar](Klar-Avatar), instead of the circle with initials. It is decorative (hidden from screen readers; the name is text next to it) and is only shown together with `userName`.", control = Text }
            , { name = "userMenu", type_ = "Html msg", description = "A [Klar.Menu](Klar-Menu) placed after the name, with the actions on the account: profile, settings, sign out. Without `userName` the menu is shown on its own.", control = Text }
            , { name = "banner", type_ = "Html msg", description = "A full-width message above the top bar, such as a notice about planned maintenance. Usually an alert from [Klar.Alert](Klar-Alert) with the `banner` look.", control = Text }
            , { name = "pageTitle", type_ = "String", description = "The title of the current page, such as \"Orders\" or \"Order 10482\": the text of its `PageHeader.title`, and of `Browser.Document.title` without the name of the application. The shell keeps it in a hidden polite live region, so a screen reader says the new title after a route change, as it would after a page load; focus has gone to the content by then", control = Text }
            , { name = "contentMaxWidth", type_ = "Int", description = "Limits the width of the page content, in pixels, and centers it in the content area. Default: no limit, the content uses the full width. Wide screens are easier to read with a limit, 1280 for example.", control = Number }
            , { name = "contentPadding", type_ = "Int", description = "The padding around the content, in steps of the 4px spacing scale; default 6, which is 24px, and 0 lets the page go edge to edge. The valid steps are 1 to 6, 8, 10 and 12, and other numbers are moved down to the nearest step (7 becomes 6). On narrow shells, below 900px, the padding never exceeds 16px.", control = Number }
            , { name = "overlays", type_ = "List (Overlay msg)", description = "The overlays of the page: dialogs, drawers, the command palette, the shortcut sheet and the toasts, each as the [`Overlay`](Klar-Overlay#Overlay) that its `view` returns. They are drawn after the page, outside the part that becomes `inert` while one of them is open. See [Klar.Overlay](Klar-Overlay) for everything the list takes care of.", control = Example }
            , { name = "height", type_ = "Int", description = "Draws the shell as a framed box this many pixels high, with a border and rounded corners, instead of filling the viewport. For demos and for embedding the shell in another page. Default: the shell fills the viewport.", control = Number }
            , { name = "width", type_ = "Int", description = "The largest width in pixels of the framed box. It only has an effect together with `height`. A shell narrower than 900px switches to the drawer layout, whatever the size of the window.", control = Number }
            , { name = "onSkipToContent", type_ = "msg", description = "Only for a shell without `AppShell.state`, whose skip link works by itself. Makes the skip link (\"Skip to main content\") a button that sends this message when it is used; answer it with `focusContent`. Without it the skip link is an ordinary `#anchor` link to the content area, which is fine unless you route on the URL fragment (it would count as a ", control = Example }
            , { name = "onStrayDrop", type_ = "msg", description = "Stops the browser from opening a file that is dropped outside a drop zone, which would replace the whole application. Give it a message that does nothing: it is sent over and over while a file is dragged across the shell, and once more for the drop. A [Klar.FileDrop](Klar-FileDrop) zone inside the shell still takes its own drops, and other drags (t", control = Example }
            , { name = "shortcuts", type_ = "Html.Attribute msg", description = "The place for the application's global keyboard shortcuts. Pass the result of `Shortcut.listen` from [Klar.Shortcut](Klar-Shortcut); the shell root becomes focusable (`tabindex=\"-1\"`) so that key presses anywhere inside it reach the listener, and the browser's own action for a key like Ctrl+K is prevented.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the skip link, the search field and the toggle buttons. The default is the language of `settings`, and `Locale.en` without them; given, it wins over the settings in any order. The shell also sets the `lang` attribute of its root element to match, so that screen readers pronounce the application in the right langua", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "The density and the language of the application, from its `Klar.Settings`. Everything inside the shell follows the density (the rows of tables, controls, cards, lists and trees), with no attribute on the components; a component that is given its own density (`Table.setDensity`) keeps it. The text of the shell and its `lang` follow the language (`Se", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "state", type_ = "(Msg -> msg) -> State page", description = "The shell's own parts of the frame, in one attribute: its id, the toggles of the sidebar and the drawer, whether they are open, and the skip link with its answer. It wins over the attributes of the section \"Without a State\" wherever it stands in the list.", control = Example }
            ]

        "SideNav" ->
            [ { name = "entries", type_ = "List (Entry key msg)", description = "The menu: sections, links and groups, from top to bottom. Without entries the menu is empty.", control = Example }
            , { name = "current", type_ = "key", description = "The key of the link that is the current page. That link gets `aria-current=\"page\"` and the current look, and a closed group that contains it is marked too. By default no entry is current.", control = Example }
            , { name = "collapsed", type_ = "Bool", description = "Shows icons only: the labels stay in the page for screen readers, counts become small dots, badges are hidden and a group opens as a flyout. Default `False`. With [Klar.AppShell](Klar-AppShell)'s state the shell sets it; a hand-wired shell passes the same flag to `AppShell.sidebarCollapsed`.", control = Choice [ "True", "False" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the `nav` landmark. Default \"Main menu\" (in the language of `locale`).", control = Text }
            , { name = "onSelect", type_ = "(key -> msg)", description = "Also tells the application which link was used, by calling the function with the `key` of the entry. It reacts to an ordinary click or a keyboard activation, not to a click with Ctrl, Cmd, Shift or Alt or with another mouse button (the browser handles those itself, for example by opening a new tab). The link still navigates, so this is only useful ", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the default name of the `nav` landmark, and of the numbers of `withCount`. Default `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "PageHeader" ->
            [ { name = "title", type_ = "String", description = "The page title, rendered as the `h1` of the page. Without a title, or with a blank one, the header renders no heading at all, so another element of the page must be its `h1`.", control = Text }
            , { name = "headingLevel", type_ = "Int", description = "The level of the heading element of the title, from 1 to 6. The default is 1, because the header is normally the top of the page. Use another level when the header sits inside a page that already has an `h1`, such as a header in a panel or a dialog, or a page with several headers (a gallery of examples). A number outside the range counts as the nea", control = Number }
            , { name = "subtitle", type_ = "String", description = "A line of gray text under the title, for a short explanation of the page.", control = Text }
            , { name = "breadcrumbs", type_ = "Html msg", description = "Where the page sits in the application, above the title. Pass a [Klar.Breadcrumbs](Klar-Breadcrumbs) trail, made with `Breadcrumbs.viewStatic` or `Breadcrumbs.view`. Together with a `backLink` the link comes first, then the trail, on the same line.", control = Text }
            , { name = "backLink", type_ = "{ href : String, label : String }", description = "A link with a left arrow back to the list the page came from, above the title. `href` is where it goes (`#/path` for navigation inside a single page application) and `label` its text.", control = Example }
            , { name = "badges", type_ = "List (Html msg)", description = "Status badges on the same line as the title, after it (they wrap below the title when there is no room). Pass [Klar.Badge](Klar-Badge) views.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "meta", type_ = "List (Html msg)", description = "A row of small facts under the subtitle, such as an identifier or the time of the last change. Make each fact with `metaItem`.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons and menus at the right end of the header, level with the title. Put the primary action first. They move below the title when there is no room beside it.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "tabs", type_ = "Html msg", description = "A row of tabs along the bottom edge of the header. Pass the tab strip made by `Tabs.view` from [Klar.Tabs](Klar-Tabs), with tabs that have no `Tabs.withPanel`: the tabs choose a route (or a view of the page), and the body of the page below the header shows it, for instance with a `case` on `Tabs.active`.", control = Text }
            , { name = "band", type_ = "Flag", description = "A white band across the full width with a line underneath, instead of a plain block. Inside [Klar.AppShell](Klar-AppShell) it cancels the padding of the content area so that the band touches the edges, so use it for the first element of a page. Anywhere else it is a white block with padding and a line under it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "sticky", type_ = "Flag", description = "Keeps the header at the top of the scrolling area while the page scrolls. Implies `band`.", control = Choice [ "Enabled", "omit" ] }
            ]

        "Breadcrumbs" ->
            [ { name = "items", type_ = "List (Crumb msg)", description = "The trail, from the top level to the current page, which comes last.", control = Example }
            , { name = "maxItems", type_ = "Int", description = "The most crumbs shown at once by `view`. Default 4; a smaller number counts as 2. When the trail has at least two crumbs more, the first crumb and the last `n - 1` crumbs stay visible and the ones between fold into the \"more\" button; a trail only one crumb longer is shown whole. `viewStatic` shows every crumb.", control = Number }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the `nav` landmark. Default \"Breadcrumb\" (in the language of `locale`).", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the name of the `nav` landmark and of the \"more\" button (\"Show 3 hidden levels\"). Default `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "Tabs" ->
            [ { name = "tabs", type_ = "List (Tab key msg)", description = "The tabs, in order. At least one of them should be enabled; when the active key belongs to no enabled tab, the first enabled one is shown as active.", control = Example }
            , { name = "boxed", type_ = "Flag", description = "Draws the tabs as boxes joined to the panel below, which gets a border of its own. The default is a plain line under the strip with the active tab underlined. A `vertical` strip always has the line look.", control = Choice [ "Enabled", "omit" ] }
            , { name = "small", type_ = "Flag", description = "Lower tabs with smaller text, for tight spaces.", control = Choice [ "Enabled", "omit" ] }
            , { name = "fill", type_ = "Flag", description = "The tabs share the full width of the strip equally, instead of being only as wide as their labels. No effect on a `vertical` strip.", control = Choice [ "Enabled", "omit" ] }
            , { name = "vertical", type_ = "Flag", description = "Stacks the tabs from top to bottom, with the panel beside them, for settings pages and detail panes. The arrow keys are Up and Down, and the list says `aria-orientation=\"vertical\"`. The default is a horizontal strip.", control = Choice [ "Enabled", "omit" ] }
            , { name = "manual", type_ = "Flag", description = "Manual activation: the arrow keys only move the focus, and Enter or Space selects the focused tab. Without it the arrows move and select in one go, which is right when switching is cheap. Use `manual` when switching is expensive, such as a tab that loads data. The active tab stays the one in the Tab order.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the tab list: what the tabs switch between, for example \"Order sections\". There is no default; without it the list has no name.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language the counts of `withCount` are written in (digit grouping). Default `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "Stepper" ->
            [ { name = "current", type_ = "Int", description = "The index of the current step, counting from 0 (default 0). The steps before it are complete and the steps after it are upcoming. An index outside the list is moved to the nearest step, in `view` and in `progress` alike, so an index past the end makes the last step the current one.", control = Number }
            , { name = "vertical", type_ = "Flag", description = "Stacks the steps from top to bottom, for sidebars and steps with long descriptions. The default is a horizontal row.", control = Choice [ "Enabled", "omit" ] }
            , { name = "small", type_ = "Flag", description = "Smaller markers, 20px instead of 26px, for tight spaces.", control = Choice [ "Enabled", "omit" ] }
            , { name = "onSelect", type_ = "(Int -> msg)", description = "Turns the steps up to the current one into buttons that send their index (counting from 0) when they are clicked or activated with the keyboard: the user can go back to a step that is done. The steps after the current one are not buttons unless `nonLinear` is given. Steps marked with `disabledStep` stay disabled; without `onSelect` no step is click", control = Example }
            , { name = "nonLinear", type_ = "Flag", description = "With `onSelect`, every step that is not disabled is a button, also the ones after the current step, for a wizard whose steps can be filled in any order (or one whose `update` checks the steps on the way, like the steps of [Klar.Form](Klar-Form)). The default lets the user go back only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the list of steps. Default \"Progress\" (in the language of `locale`).", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the name of the list, the status read out for a step (\"completed\", \"has errors\", \"unavailable\") and the \"Step 2 of 5\" summary of `progress`. Default `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "Accordion" ->
            [ { name = "bordered", type_ = "Flag", description = "A thin gray border around the whole accordion and a line between the sections, on a white background. This is the default; it undoes an earlier `flush`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "flush", type_ = "Flag", description = "No outer border and no background, only a thin line under each section and above the first one. For use inside a card or a drawer.", control = Choice [ "Enabled", "omit" ] }
            , { name = "small", type_ = "Flag", description = "Lower headers with smaller text, for dense panels.", control = Choice [ "Enabled", "omit" ] }
            , { name = "headingLevel", type_ = "Int", description = "The level, 1 to 6, of the heading element that wraps each header button (`h3` by default; other numbers are moved into that range). Pick the level that fits below the headings of the page around the accordion, so that the outline of the page stays correct.", control = Number }
            ]

        "Toolbar" ->
            [ { name = "ariaLabel", type_ = "String", description = "The accessible name of the bar (`aria-label`): what the group of controls is for, for example \"Orders\". There is no default; without it the bar has no name.", control = Text }
            , { name = "size", type_ = "Size", description = "The height of the controls inside the bar, from a value (for example the size the user picked in the settings): `Small` 26px, `Medium` 32px (the default) or `Large` 40px, with the padding to match. Buttons and inputs inside the bar follow, unless they have a size of their own. `small` and `large` are shorthands.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "small", type_ = "Flag", description = "A compact bar: 26px controls instead of the usual 32px, and less padding. The same as `size Small`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "large", type_ = "Flag", description = "A roomy bar: 40px controls and more padding. The same as `size Large`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "plain", type_ = "Flag", description = "No border, no background and no padding, for a toolbar that sits inside another surface such as a card header.", control = Choice [ "Enabled", "omit" ] }
            , { name = "scroll", type_ = "Flag", description = "Keeps every control on one line and scrolls the bar sideways when they do not fit, instead of wrapping onto more lines.", control = Choice [ "Enabled", "omit" ] }
            ]

        "DescriptionList" ->
            [ { name = "columns", type_ = "Int", description = "The largest number of columns, from 1 to 3 (other numbers are moved into that range). Default 1. It is a maximum: the grid uses fewer columns when there is no room for them, because a column is never narrower than 200px.", control = Number }
            , { name = "labelBeside", type_ = "Flag", description = "Puts the label in a column to the left of the value instead of above it. The column is 160px wide; change it with `labelWidth`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "labelWidth", type_ = "Int", description = "The width in pixels of the label column when the label is beside the value. Default 160. Without `labelBeside` it has no effect.", control = Number }
            , { name = "bordered", type_ = "Flag", description = "A thin line under every row.", control = Choice [ "Enabled", "omit" ] }
            , { name = "density", type_ = "Density", description = "How tightly the rows are packed: `Compact` (less space between the rows, for dense detail views), `Normal` or `Comfortable` (more space). Without it the list follows the density of the application (`Klar.Settings`), so give it only to a list that must differ from the rest.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the hidden text that stands for a missing value: \"Not provided\" in English, which is the default (`Locale.en`). The visible dash is the same in every language.", control = Choice [ "en", "nb" ] }
            ]

        "Sortable" ->
            [ { name = "ariaLabel", type_ = "String", description = "The accessible name of the list, for example \"Pick sequence\". Give every list on a page its own name; without it the list has none.", control = Text }
            , { name = "horizontal", type_ = "Flag", description = "The items run side by side (a chip list) instead of one below the other, and wrap onto more lines when they do not fit. The keyboard moves an item with the `Left` and `Right` arrow keys instead of `Up` and `Down`. The default is a vertical list.", control = Choice [ "Enabled", "omit" ] }
            , { name = "wholeItem", type_ = "Flag", description = "Lets the mouse take hold of an item anywhere, not only by its handle, except on buttons, links, fields and other things that react to a press themselves. A finger or pen still uses the handle only, so that the rest of the item scrolls the page. The handle stays: it is how the keyboard and screen readers reach the item. The default is the handle onl", control = Choice [ "Enabled", "omit" ] }
            , { name = "moveButtons", type_ = "Flag", description = "Gives every item that can move two small buttons at its end, \"Move up\" and \"Move down\" (\"Move left\" and \"Move right\" in a `horizontal` list): the way to reorder for a person who uses a pointer and cannot drag (WCAG 2.5.7). A press moves the item one place, past no `fixed` item, and lands in `reorder` like a drop; the live region says where it went,", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "Makes the whole list unchangeable: the handles are dimmed and cannot be used. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "emptyText", type_ = "String", description = "The text drawn when there are no items. The default is \"No items\".", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the description of the handle, the announcements, \"Fixed position\", the names of the `moveButtons` and the empty text. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "Splitter" ->
            [ { name = "stacked", type_ = "Flag", description = "The panes lie one above the other, with horizontal separators, instead of side by side. The keyboard then moves a separator with `Up` and `Down`. The default is side by side.", control = Choice [ "Enabled", "omit" ] }
            , { name = "height", type_ = "Int", description = "The height of the splitter in pixels. Without it the splitter is as high as its parent, which must then have a height of its own; a splitter inside a pane of another splitter does not need one. A `stacked` splitter needs a height to be able to divide anything.", control = Number }
            , { name = "fillRest", type_ = "Flag", description = "Makes the splitter as high as the room that is left in its parent, instead of as high as the parent (which must have a height of its own) or a number of pixels. Use it in a `Layout.stack [ Layout.fillRest ]`, so that a navigator beside a work area fills the window under the page header with no pixel height; see `Layout.fillRest`. It overrides `heig", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: \"Resize\" in the name of a separator and the value (\"40 percent\"). The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "Kanban" ->
            [ { name = "onOpen", type_ = "(cardId -> msg)", description = "Turns card titles into buttons sending their application id. Absent by default.", control = Example }
            , { name = "disabled", type_ = "Bool", description = "Prevents new moves and confirmation. Existing cards remain readable. Defaults to `False`.", control = Choice [ "True", "False" ] }
            , { name = "headingLevel", type_ = "Int", description = "Level of column headings, from 1 through 6. Defaults to 3; other values use 3.", control = Number }
            , { name = "onRetry", type_ = "msg", description = "Retry message for initial errors and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Formats retained-data timestamps in the application's zone. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "StatusPage" ->
            [ { name = "title", type_ = "String", description = "The large title, replacing the one of the kind. A blank title leaves out the heading altogether, so then another element of the page must be its `h1`.", control = Text }
            , { name = "description", type_ = "String", description = "The sentence under the title, replacing the one of the kind. A blank text leaves it out.", control = Text }
            , { name = "icon", type_ = "Icon", description = "Another icon than the one of the kind, for example `Icon.package` on a success page that is about a shipment. The color still follows the kind.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "actions", type_ = "List (Html msg)", description = "The row of actions under the text: buttons or links, in the order you give them, the most important first. There are none by default. A page nearly always needs one, so that the user is never left in a dead end.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "reference", type_ = "String", description = "A correlation id for support, such as the id of the failed request, shown small under the actions as \"Reference: req-7f3a-91c2\". The text is selected completely by one click, so that `Ctrl C` copies it (a button that copies needs JavaScript). There is none by default, and a blank one is left out, like a blank title.", control = Text }
            , { name = "onRetry", type_ = "msg", description = "The message sent by a \"Try again\" button, placed before your own actions. The button is there only when trying again can help: for `server`, `network`, `maintenance` and a `fromProblem` page whose problem is worth retrying (`Remote.isRetryable`), and never for the others. Without `onRetry` there is no button.", control = Example }
            , { name = "retrying", type_ = "Bool", description = "Whether the request that \"Try again\" sent is on its way: while `True` the button shows a spinner, is busy and ignores clicks, and keeps focus where it is (`Button.loading`). Pass a field of your model. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "backAt", type_ = "Time.Posix", description = "When the service is expected back, for `maintenance`: the sentence under the title becomes \"We are making improvements. Expected back at 14:30.\" The time is written in the zone of `settings` (in UTC, ending in \"UTC\", without it), as a time of day, so it is meant for a pause within the day. A `description` of your own wins over it; other kinds of pa", control = Number }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time of `backAt`. The default is `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "headingLevel", type_ = "Int", description = "The level of the title element, from 1 to 6. The default is 1, because the page is normally the whole page. Use another level when the page sits inside a layout that already has an `h1`. A number outside the range counts as the nearest level. The level changes the element, not the look.", control = Number }
            , { name = "standalone", type_ = "Flag", description = "The page stands on its own, with no `AppShell` around it: it is at least as tall as the window and it is the `main` landmark of the document. Without it the page fills the region it is placed in and is an ordinary `div`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the element that `Klar.focus` moves focus to, which must be unique on the page: the title, which becomes focusable, or the whole page when it has no title (a blank `title`), so that there is always something to focus. Give `Klar.focus` the same text. There is no id by default.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the texts of the kinds, \"Try again\" and the label of the reference. The default is [`Locale.default`](Klar-Locale#default), which is English. The title and the explanation of a `fromProblem` page come from the problem, in this language.", control = Choice [ "en", "nb" ] }
            ]

        "BulkBar" ->
            [ { name = "selectAllMatching", type_ = "{ total : Int, onPage : Int, onSelectAll : msg }", description = "Says that more items match than the page shows, so the bar can say \"200 of 12,340 selected\" and offer \"Select all 12,340 matching\".", control = Example }
            , { name = "itemName", type_ = "{ one : String, other : String }", description = "What the items are called, in the language of the page, one and several: the bar then says \"12 orders selected\", \"200 of 12,340 orders selected\" and \"1 order selected\", and so does the name of the group and what a screen reader is told. The default is no name: \"12 selected\". Give the words in the language you give to `locale`.", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the box that the toolbar and the bar share, which must be unique on the page. With it the box can take focus, so that `Klar.focus` has a place to put it when the bar goes away. There is no id by default.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the count, \"Clear selection\", \"Select all N matching\" and the name of the group of buttons. The default is [`Locale.default`](Klar-Locale#default), which is English. Numbers are written the way the language does (\"12,340\" or \"12 340\").", control = Choice [ "en", "nb" ] }
            ]

        "LeaveGuard" ->
            [ { name = "title", type_ = "String", description = "The question, replacing \"Leave without saving?\". It is the accessible name of the dialog.", control = Text }
            , { name = "message", type_ = "String", description = "The sentence under the question, replacing \"You have unsaved changes. If you leave now, they are lost.\" Name what is lost: \"Order 1042 and its lines are not saved.\"", control = Text }
            , { name = "saveAndLeave", type_ = "Flag", description = "Adds a third button, \"Save and leave\", for the application that can save from here. Pressing it closes the dialog and `update` gives you a `Decision` for which `savesFirst` is `True`. It is the primary button of the dialog; focus still starts on \"Stay\".", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the question, the sentence and the buttons. The default is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            ]

        "History" ->
            [ { name = "locale", type_ = "Locale", description = "The language of the built-in text: the names of the buttons, \"Undid: ...\" and \"Redid: ...\" for screen readers, the name of the group, and the names of the shortcuts on the shortcut sheet. The default is [`Locale.default`](Klar-Locale#default), which is English.", control = Choice [ "en", "nb" ] }
            , { name = "showShortcuts", type_ = "Flag", description = "Shows `Ctrl Z` and `Ctrl Shift Z` in the tooltips and tells assistive technology about them (`aria-keyshortcuts`). Add it only when the application has registered `shortcuts`: a hint for a key that does nothing is a lie.", control = Choice [ "Enabled", "omit" ] }
            ]

        "Markdown" ->
            [ { name = "locale", type_ = "Locale", description = "The language of the few labels that are not part of the text: \"Code\", \"Table\", \"Image\". Default `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            , { name = "headingOffset", type_ = "Int", description = "Moves every heading down by this many levels (0 to 5), for a document that is shown under headings of its own: with `headingOffset 2` a `#` is an `h3`. Levels stop at `h6`. Default 0. It changes the outline that screen readers read, not the look: a heading is drawn by its level in the text, so a `#` looks the same at every offset, and `####` and `#", control = Number }
            , { name = "idPrefix", type_ = "String", description = "Text put in front of the id of every heading. Default `\"md-\"`, so that text which someone else wrote cannot make an element with an id that the page uses. Choose another for a page that shows several documents with the same headings (a list of answers that all have a \"Summary\"), or give it the id of the answer. Give `headings` the same attributes, ", control = Text }
            , { name = "images", type_ = "Flag", description = "Shows images as images, for relative paths and for `http:` and `https:` addresses. By default an image is shown as a link with its description, because loading it from another site tells that site that the text was read, and the address of an image can carry what a text from a model knows. Turn it on only for text you trust: a relative path is a re", control = Choice [ "Enabled", "omit" ] }
            , { name = "imagesFrom", type_ = "List ImageHost", description = "Shows images from relative paths and from these hosts, and every other image as a link with its description. The match is exact: a subdomain needs its own entry and the case does not matter. An address that has a port, a user name, a percent sign or brackets in its host never matches, nor does an `http:` address without `//` straight after the colo", control = Example }
            , { name = "customLink", type_ = "({ href : String, external : Bool, title : String, content : List (Html msg) } -> Maybe (Html msg))", description = "Draws some links of the text yourself. The function gets every link of the text (not the link that stands in for an image that is not loaded, see `images`): its address (`href`, after the checks of this module, so `javascript:` and the like never reach it, and a link to a heading of the text already has the prefix), whether it goes to another site,", control = Example }
            , { name = "customCodeBlock", type_ = "({ language : String, code : String } -> Maybe (Html msg))", description = "Draws some blocks of code yourself. The function gets the language written after the fence (`\"\"` when there is none) and the code as it was written, and gives the Html to show, or `Nothing` for the block as it is drawn without the function: with a label for the language, in a box that scrolls. Use it for syntax highlighting, a diagram drawn from th", control = Example }
            ]

        "MarkdownEditor" ->
            [ { name = "label", type_ = "String", description = "The label above the editor. Clicking it focuses the text area and screen readers read it as the name of the text area. Give every editor a label, or hide it with `labelHidden`.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Hides the `label` visually but keeps it for screen readers.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "Help text under the editor, for example what the text is for. Screen readers read it together with the label.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the editor and marks it invalid. Screen readers announce the message when it appears. An editor with a `maxLength` shows its own error when the text is too long, unless you give one. To show an error only sometimes, use `errorMaybe`.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Just message` shows the message and `Nothing` shows none.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required` on the text area. This checks nothing: look at the text yourself and show an `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text such as `\"(optional)\"` after the label of a field that is not `required`. By default nothing is shown.", control = Text }
            , { name = "rows", type_ = "Int", description = "The height of the text area and of the preview, in lines of text. Default 12, and never less than 3. The text scrolls inside the editor, so the page does not change height as the text grows.", control = Number }
            , { name = "placeholder", type_ = "String", description = "Text shown in the empty text area, for example an example of what to write. It is not a substitute for the `label`. Default: none.", control = Text }
            , { name = "maxLength", type_ = "Int", description = "Shows a counter such as `120/2000` under the editor at the end of the line with the hint. It turns amber when the limit is near, and red when the text is longer, with the error \"The text is longer than 2000 characters.\" (unless you give an error of your own). Nothing is cut off, and the user can still type and paste: a limit that silently loses a p", control = Number }
            , { name = "disabled", type_ = "Bool", description = "While `True` the editor is dimmed and cannot be focused or changed. Default `False`. The preview still shows the text.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the user can focus the text, select it and read the preview, but the text cannot be changed and the toolbar is off. Default `False`.", control = Choice [ "True", "False" ] }
            , { name = "onFocus", type_ = "msg", description = "Sends this message when the text area gets the focus.", control = Example }
            , { name = "onBlur", type_ = "msg", description = "Sends this message when the text area loses the focus: a good moment to check the text, so that an error does not appear while the user is still typing.", control = Example }
            , { name = "tabbed", type_ = "Flag", description = "Always two tabs, \"Write\" and \"Preview\", also when the container is wide. Use it for a narrow place that is not narrow enough for the editor to notice, or when you want one thing at a time. Without it and without `sideBySide` the layout follows the width of the container: tabs below 40em, side by side above.", control = Choice [ "Enabled", "omit" ] }
            , { name = "sideBySide", type_ = "Flag", description = "Always the text area and the preview side by side, also in a narrow container.", control = Choice [ "Enabled", "omit" ] }
            , { name = "preview", type_ = "List (Markdown.Attribute msg)", description = "Attributes for the preview, which is a [Klar.Markdown](Klar-Markdown) view: `Markdown.images`, `Markdown.imagesFrom`, `Markdown.headingOffset` and the others. The `locale` and the `idPrefix` of the preview are the editor's own, and its headings are moved down two levels (`Markdown.headingOffset 2`: a `#` is an `h3`), because the preview is part of ", control = Example }
            , { name = "syntaxHelp", type_ = "Flag", description = "A line under the editor, \"Markdown is supported\", that opens a short list of the syntax. Off by default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the buttons, the tabs, the preview, the count and the error of the limit. Default `Locale.default`, which is English. Texts you give yourself are shown as they are.", control = Choice [ "en", "nb" ] }
            ]

        "Diff" ->
            [ { name = "ariaLabel", type_ = "String", description = "The accessible name of the diff, such as \"Changes to the shipping policy\". It names the box of the changes, which screen readers announce as a region in `view` and as a group in `viewStatic`; when that box is no tab stop (see `wrapLines` and `maxHeight`), it names the whole diff, as a group. The default is \"Changes\".", control = Text }
            , { name = "context", type_ = "Int", description = "How many unchanged lines are shown around each change in a text diff; the rest are folded into a row that says how many they are and opens when it is pressed. The default is 3, and the value is kept between 0 and 20.", control = Number }
            , { name = "maxChanges", type_ = "Int", description = "How many changes are drawn before a row says \"Showing 200 of 1,340 changes\" and offers to show more. The default is 200, and the value is kept between 10 and 5000. It keeps a diff with thousands of changes fast. A block of more than 500 changed lines is cut as well, after 500 lines, with a button that shows 500 more. `viewStatic` has no buttons, so", control = Number }
            , { name = "maxHeight", type_ = "Int", description = "Scrolls inside the viewer when the diff is taller than this many pixels. By default the viewer grows with its content. A diff of lines scrolls sideways inside its own box in any case, never the page.", control = Number }
            , { name = "wrapLines", type_ = "Flag", description = "Wraps long lines of a text diff instead of scrolling sideways. Good for prose, such as a policy; code is easier to read when it keeps its lines. In `view` the box of the lines stays a tab stop, for `n` and `p`; in `viewStatic`, with nothing to scroll sideways, it is a tab stop only when it has a `maxHeight`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "showUnchangedFields", type_ = "Flag", description = "Shows the fields that did not change as well, muted, in a diff made with `fields`. By default only the fields that changed are shown. It has no effect on other diffs.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the toolbar, the rows that fold unchanged lines, the counts and the notes. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Compare" ->
            [ { name = "baseline", type_ = "id", description = "The record the others are compared with, by its id. The default is the first record. When no record has this id (it was taken out of the comparison), the first record is the baseline again, and its column says so.", control = Example }
            , { name = "onBaseline", type_ = "(id -> msg)", description = "Lets the user choose the baseline: the heading of every record gets a small button \"Set as baseline\", and the function gets the id of the record that was chosen. Keep it in your model and give it back with `baseline`. The heading of the baseline says \"Baseline\" in the same place, as a button that cannot be pressed (`aria-disabled`), so the focus st", control = Example }
            , { name = "onlyDifferences", type_ = "Bool", description = "While `True`, the rows where every record is equal are left out, and so are the headings above only such rows. The default is `False`: every row is drawn, and the rows that are equal are dimmed. Keep the `Bool` in your model; with a single record there is nothing to compare and every row is drawn.", control = Choice [ "True", "False" ] }
            , { name = "onOnlyDifferences", type_ = "(Bool -> msg)", description = "Adds the switch \"Show only differences\" to the toolbar above the table. It is on while `onlyDifferences` is `True`, and the function gets the new value when the user flips it. Without this attribute there is no switch. With a single record the switch is dimmed, as there is nothing to compare.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "The message sent by \"Try again\": in the failure (`Failed`), and in the marker of old data (`Kept` after a refresh that failed). Without it there is no button, and the button only appears for problems worth retrying (see `Remote.isRetryable` in [Klar.Remote](Klar-Remote)). The button goes away once the new data is there; give the comparison an `id` ", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the comparison, unique on the page. The comparison is one element in every state (loading, failed, empty, data), and with an id it can take focus, so that `Klar.focus` has a place to put it when \"Try again\" goes away:", control = Text }
            , { name = "density", type_ = "Density", description = "How tightly the rows are packed, like the density of [Klar.Table](Klar-Table): `Compact`, `Normal` or `Comfortable`. Without it, or with `Normal`, the rows follow the density of the application (`Klar.Settings`).", control = Example }
            , { name = "maxHeight", type_ = "Int", description = "Scrolls inside the table when it is taller than this many pixels, with the headings of the records staying at the top. By default the table grows with its rows; it scrolls sideways inside its own box in any case.", control = Number }
            , { name = "emptyState", type_ = "List (EmptyState.Attribute msg)", description = "Changes the empty state, which shows when there are no records: it has a title (\"Nothing to compare\") and a description, and these attributes are applied after them, so yours win. Use it to say how to add records and to give the button for it.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the heading of the column of the fields, the words for the baseline and the differences, the switch, the counts and the marker of old data. The default is `Locale.default`, which is English. Your own labels and values are shown as you give them.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "AuditLog" ->
            [ { name = "id", type_ = "String", description = "A DOM id unique on the page, and a stable focus target after retry. It also names the search input, so use it when two histories appear on the same page. Absent by default; then the search field derives its id from its label.", control = Text }
            , { name = "search", type_ = "String -> (String -> msg)", description = "Adds a controlled search of actor, action and detail in loaded entries. Search ignores case and accents. No search field by default.", control = Example }
            , { name = "onLoadMore", type_ = "msg", description = "Adds a load-more button; it also appears when search has no matches.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry for initial failures and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Time zone and timestamp formatting. Defaults to `Settings.default`, explicitly UTC.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "ConflictResolver" ->
            [ { name = "onApply", type_ = "(List ( id, Maybe String ) -> msg)", description = "Adds an apply button. Receives the complete resolved field list only after an explicit click. Disabled for stale, refreshing, empty or unresolved data.", control = Example }
            , { name = "saving", type_ = "Bool", description = "Disables choices and shows the apply button busy while a save is pending. Defaults to `False`.", control = Choice [ "True", "False" ] }
            , { name = "onRetry", type_ = "msg", description = "Retry for initial failures and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Language of built-in text. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Formatting of retained-data timestamps. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "CodeBlock" ->
            [ { name = "language", type_ = "Language", description = "Lexical highlighting. Defaults to `plain`.", control = Choice [ "plain", "json", "elm" ] }
            , { name = "lineNumbers", type_ = "Bool", description = "Shows an unselectable gutter. Defaults to `False`.", control = Choice [ "True", "False" ] }
            , { name = "highlightLines", type_ = "List Int", description = "One-based lines to mark, with an underline as well as a background. Nonpositive and nonexistent lines have no effect. No lines are marked by default.", control = Text }
            , { name = "maxLines", type_ = "Int", description = "Limits the preview to this many lines; zero or negative values show no source lines. The footer always discloses truncation. Unrestricted by default.", control = Number }
            , { name = "maxHeight", type_ = "Int", description = "Maximum scroll-region height in pixels, at least 80. Unrestricted by default.", control = Number }
            , { name = "download", type_ = "String", description = "Adds a native download link for the complete source with this suggested file name. The browser may sanitize the name. No download link by default.", control = Text }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            ]

        "CommentThread" ->
            [ { name = "onSubmit", type_ = "(Submission id -> msg)", description = "Adds the draft composer and explicit post button. Receives an exact snapshot; the application sends it, updates comments and acknowledges success. Absent by default.", control = Example }
            , { name = "sending", type_ = "Bool", description = "Marks a pending post and blocks another submit. The draft stays editable so the next comment can be written while the current one is sent. False by default.", control = Choice [ "True", "False" ] }
            , { name = "errorMaybe", type_ = "Maybe String", description = "A posting error announced above the composer. The draft is kept for retry. Nothing by default. This is separate from failures to load comment history.", control = Text }
            , { name = "maxLength", type_ = "Int", description = "The draft limit, default 10,000 UTF-16 code units, matching native text controls. Over-limit text remains editable and is shown with an error, never truncated. Configuration below zero means zero.", control = Number }
            , { name = "onResolve", type_ = "(id -> Bool -> msg)", description = "Adds Resolve/Reopen controls. Receives the comment id and requested new state; the application supplies `resolved` data and handles permissions/persistence. These controls are disabled while history is stale or refreshing.", control = Example }
            , { name = "actions", type_ = "(id -> List (Html msg))", description = "Additional per-comment actions, keyed by your own id. Empty by default. Permission checks and edit/delete confirmation belong to the application.", control = Example }
            , { name = "onLoadMore", type_ = "msg", description = "Adds a load-more action, including when no comments are loaded. Append the response and focus the thread root in its handler if the button will disappear.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry for loading failures and stale history. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text language. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Time zone for creation/edit times and retained-data notices. Defaults to UTC.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "PermissionMatrix" ->
            [ { name = "onChange", type_ = "(List (Change role permission) -> msg)", description = "Makes the matrix editable and says where changes go. A click or a key press on a cell sends one message with a list of one `Change`; a header checkbox sends one message with all the cells it changes. Delete or Backspace, and the \"inherit again\" mark, send a change that says the role has no access of its own any more. Locked roles never change. With", control = Example }
            , { name = "saved", type_ = "(role -> permission -> Cell)", description = "The values as they were last saved, in the same form as `cell`. A cell where the role's own access differs from the saved one (what is inherited does not count) is marked with a dot and \"unsaved change\" for screen readers, and the number of such cells is counted above the grid. Give a new function when the data has been saved or loaded again, and t", control = Example }
            , { name = "toolbarActions", type_ = "List (Html msg)", description = "Your own buttons, such as Save and Discard, shown at the end of the line above the grid, next to the number of unsaved changes. The default is none.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "density", type_ = "Density", description = "The height of the rows: `Compact`, `Normal` or `Comfortable`, the same as [Klar.Table](Klar-Table) (see [Klar.Theme](Klar-Theme)). Without it the rows follow the density of the application (`Klar.Settings`), which is `Normal` unless it says otherwise; with it the matrix has this density whatever the application's is.", control = Example }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the grid, for example \"Permissions of the roles\". The default is \"Permissions\", in the language of `locale`.", control = Text }
            , { name = "maxHeight", type_ = "Int", description = "The height in pixels at which the grid starts to scroll inside itself, with the headers and the names of the permissions staying in view. The default is 70% of the height of the window, so a long list scrolls instead of making the page long.", control = Number }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button when `viewRemote` shows a failure that is worth retrying, or old data whose refresh failed. Without it there is no such button. The button goes away while the data loads: in the update branch of this message, call `Klar.focus` with the id given to `init`.", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of \"Old data from 14:05\" when `viewRemote` shows data whose refresh failed. Without it the time is written in UTC and says so.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the words of the cells, the names for screen readers, the filter and the notes. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "ApprovalFlow" ->
            [ { name = "viewer", type_ = "Maybe approver", description = "Who is looking at the flow, in the same type as the approvers, or `Nothing` for someone who is not signed in or not involved. When the viewer is an approver who has not decided on the step being decided, that step gets the \"Approve\" and \"Reject\" buttons (see `onApprove` and `onReject`) and the viewer's name says \"(you)\". The default is `Nothing`.", control = Example }
            , { name = "onApprove", type_ = "msg", description = "The message sent by the \"Approve\" button. The button is shown to a `viewer` who has to decide on the current step. Without it there is no such button.", control = Example }
            , { name = "onReject", type_ = "msg", description = "The message sent by the \"Reject\" button, shown like \"Approve\". The viewer asks for nothing: if a rejection needs a reason, open your own dialog or field when this message arrives and send the decision with its comment afterwards.", control = Example }
            , { name = "deciding", type_ = "Bool", description = "Whether a decision of the viewer is on its way: set it to `True` when you send the request (in the branch of the `onApprove` or `onReject` message, or when the reason of a rejection is sent) and back to `False` when the answer comes. While it is `True` the \"Approve\" and \"Reject\" buttons show a spinner, say `aria-busy`, ignore clicks and keep the fo", control = Choice [ "True", "False" ] }
            , { name = "headingLevel", type_ = "Int", description = "The level, 1 to 6, of the heading of each step's title (`h3` by default; other numbers are moved into that range), so a screen reader can go from step to step. The headings must follow the ones of the page: a flow in a card with an `h2` title keeps 3, one directly under the `h1` of a page takes 2. The same as `Timeline.headingLevel`.", control = Number }
            , { name = "now", type_ = "Time.Posix", description = "The current time. It decides whether a step is overdue and lets the times carry a tooltip such as \"3 days ago\". Without it nothing is marked overdue. The viewer does not read the clock: keep the value in your model and update it.", control = Number }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the times of decisions and deadlines. Without it the times are written in UTC and end in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "horizontal", type_ = "Flag", description = "Lays the steps out side by side, for a wide and short strip. The default is vertical, one step below the other, which suits a side panel and long comments. A row with many steps scrolls sideways; so that it can be scrolled from the keyboard, the strip is a tab stop of its own (named like the flow), also when it fits.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the flow, such as \"Approval of credit note 2024-117\". The flow is a named group (not a landmark, so a page with many flows does not get many regions), and this is what a screen reader says when the flow takes the focus. The default is \"Approval steps\" in the language of `locale`.", control = Text }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button when `viewRemote` shows a failure that is worth retrying, or old data whose refresh failed. Without it there is no such button. The button goes away while the flow loads: in the update branch of this message, call `Klar.focus` with the `id` of the flow.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: statuses, rules, \"Overdue\", the buttons and the labels for screen readers, and of the format of times. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the flow, which must be unique on the page. It is on the flow in every state (loading, failed, empty, the steps), and the flow can then take focus (`tabindex` -1), so `Klar.focus` finds it after \"Try again\" and after a decision, when the buttons that had the focus are gone. There is no id by default.", control = Text }
            ]

        "Stat" ->
            [ { name = "label", type_ = "String", description = "What the number is, in sentence case and without a colon: \"Open orders\". It is the heading of the tile and stays on one line; a long label is cut with an ellipsis and its full text is the tooltip. Default: empty.", control = Text }
            , { name = "value", type_ = "String", description = "The number as text that you have formatted yourself: `\"1,284\"`, `\"87%\"`, `\"14.5\"`. To let the tile format it with its `locale`, use `int`, `decimal`, `abbreviated` or `money` instead. Without any of them the tile shows a dash.", control = Text }
            , { name = "int", type_ = "Int", description = "A whole number, written with the thousands separator of the tile's `locale`: `1284` is \"1,284\" in English.", control = Number }
            , { name = "decimal", type_ = "Int -> Float", description = "A number with a fixed count of decimals, in the decimal and thousands separators of the tile's `locale`: `decimal 1 14.53` is \"14.5\" in English. The number is rounded, not cut. A number that is not finite (NaN or infinity) is shown as an en dash.", control = Example }
            , { name = "money", type_ = "Money", description = "An amount of money, written with the symbol of its currency in the conventions of the tile's `locale` (`$1,234.50` in English, `1 234,50 kr` in Norwegian), exactly as `Money.toSymbolString` writes it. Use it instead of formatting the amount yourself, so that money stays `Klar.Money` all the way to the screen. A symbol can stand for several currenci", control = Example }
            , { name = "abbreviated", type_ = "Float", description = "A number that shortens itself when it is large: `12900` stays \"12,900\", but `4200000` becomes \"4.2M\". Millions are written \"M\", billions \"B\" and trillions \"T\" (English). Below a million the number is written in full, with at most one decimal. A number that is not finite (NaN or infinity) is shown as an en dash.", control = Number }
            , { name = "unit", type_ = "String", description = "A unit written after the number, smaller and muted: \"days\", \"USD\", \"%\".", control = Text }
            , { name = "delta", type_ = "Float", description = "The change since last time, as a percentage: `4.2` is shown as \"+4.2%\" and `-8` as \"−8%\" (with a true minus sign), rounded to one decimal. The sign picks the arrow and, together with `lowerIsBetter`, the color. A change smaller than 0.05 counts as unchanged and gets a dash. A value that is not a number (NaN or infinity) shows no change.", control = Number }
            , { name = "deltaBy", type_ = "Float", description = "The change since last time as a difference in the tile's own units: `12` is shown as \"+12\" and `-3.5` as \"−3.5\", in the separators of the `locale`. It is written the way the tile writes its value: whole for `int`, with the same decimals for `decimal` (`0.03` on a `decimal 2` tile is \"+0.03\"), abbreviated for `abbreviated` (\"+1.5M\" next to \"4.2M\"), ", control = Number }
            , { name = "deltaPoints", type_ = "Float", description = "The change of a number that is itself a rate, in percentage points: a conversion rate from 3.2% to 3.5% is `deltaPoints 0.3`, shown as \"+0.3 pp\" (\"+0,3 p.p.\" in Norwegian). A relative change of a rate (\"+9.4%\") is almost never what the reader thinks it is. The sign picks the arrow and the color, as with `delta`.", control = Number }
            , { name = "change", type_ = "{ current : Float, previous : Float }", description = "The change from a previous value to the current one, worked out for you: the same as `delta` with the percentage `(current - previous) / |previous| * 100`. When the previous value is 0 there is no percentage: two zeros are unchanged (a dash), and from 0 to anything else no change is shown (use `deltaText \"new\"` to say so), never `NaN` or infinity.", control = Example }
            , { name = "moneyChange", type_ = "{ current : Money, previous : Money }", description = "The change between two amounts of money, as a percentage, worked out in minor units: the same as `change`, and nothing is shown when the two are in different currencies (a percentage of two currencies means nothing) or the previous amount is zero.", control = Example }
            , { name = "deltaText", type_ = "String", description = "The change as text of your own: \"+12 orders\". Pair it with `delta` to set the arrow and the color; on its own the text is shown in neutral gray, without an arrow.", control = Text }
            , { name = "deltaLabel", type_ = "String", description = "What the change is measured against: \"vs. last week\". It follows the change and is only shown when there is one (`delta` or `deltaText`).", control = Text }
            , { name = "lowerIsBetter", type_ = "Flag", description = "Says that a decrease is the good direction, as with delivery times, error rates and costs: a falling number is then green and a rising one red.", control = Choice [ "Enabled", "omit" ] }
            , { name = "deltaTone", type_ = "Tone", description = "Overrides the color of the change, whatever its direction. `Neutral` is gray, `Success`, `Warning` and `Danger` are green, amber and red. The `Tone` type is in [Klar.Theme](Klar-Theme).", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "caption", type_ = "String", description = "A line of explanation under the number and its change: \"Excluding returns\".", control = Text }
            , { name = "trend", type_ = "List Float", description = "A small trend line under the tile, with the last values oldest first; about 12 is plenty. Nothing is drawn for fewer than two values. The line is a `sparkline` from [Klar.Chart](Klar-Chart), and its accessible name is the label followed by \"trend\".", control = Text }
            , { name = "trendTone", type_ = "Tone", description = "The color of the trend line. The default is `Primary` (blue).", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "icon", type_ = "Icon", description = "A small icon at the right end of the label line.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "size", type_ = "Size", description = "The size of the number: `Small` (20px), `Medium` (26px, the default) or `Large` (34px). The `Size` type is in [Klar.Theme](Klar-Theme). Without it the size follows the density of the application (`Klar.Settings`): 20px when compact, 26px when normal, 30px when comfortable.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "flat", type_ = "Flag", description = "No border and no background, for a tile that sits inside a card or another bordered container. Tiles in a `row` are already drawn without a border of their own.", control = Choice [ "Enabled", "omit" ] }
            , { name = "onClick", type_ = "msg", description = "Makes the whole tile a button that sends this message when it is clicked or activated with the keyboard: for drilling down into the numbers. Without it the tile is a plain block.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" link in the failure state. The link is only shown when the problem is worth retrying (see `Klar.Remote.isRetryable` in [Klar.Remote](Klar-Remote)).", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the tile. A tile that is not a button can then take focus from a command in every state (loading, failed, old data, drawn): the \"Try again\" link is replaced when the request starts again and focus would fall back to the page, so call [`Klar.focus`](Klar#focus) with this id in the same `update` branch. The id must be unique on the page", control = Text }
            , { name = "remote", type_ = "Remote a -> (a -> List (Attribute msg))", description = "Takes the content of the tile from a `Remote`. While the data is `NotAsked` or `Loading` the tile shows a skeleton, on `Failed` it shows the problem, and when the data has arrived it applies the attributes that the function returns for it. Data that is `Kept` stays on the tile: dimmed and busy while it is refreshed, and with \"Old data from 14:05\" a", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (\"Loading\", \"Try again\" and the hidden \"increase\" and \"decrease\") and of the number format. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "Chart" ->
            [ { name = "id", type_ = "String", description = "The DOM id of the chart, which then sits in an element that can take focus in every state (loading, failed, old data, drawn). The \"Try again\" button is replaced when the request starts again and focus would fall back to the page: call [`Klar.focus`](Klar#focus) with this id in the same `update` branch. The id must be unique on the page.", control = Text }
            , { name = "title", type_ = "String", description = "A visible heading above the chart. It is also the accessible name of the chart (and the caption of its hidden data table), unless `ariaLabel` is set. A meter shows it at the left above the scale. A sparkline has no room for a heading: give it an `ariaLabel` instead.", control = Text }
            , { name = "description", type_ = "String", description = "A line of explanation under the title, for example the period or the source of the numbers. A meter and a sparkline do not show it.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the chart, for screen readers. Use it when there is no visible `title`; when both are set, the `ariaLabel` is the accessible name (and the caption of the hidden data table) and the title is only shown. A sparkline has no title, so give it an `ariaLabel` that says what it shows: \"Orders, last 7 days\".", control = Text }
            , { name = "categories", type_ = "List String", description = "The names of the categories of a line or bar chart, one per value, in the order of the values. They label the x axis (the left side of a horizontal bar chart). A missing name is replaced by its position (1, 2, 3 ...), and names beyond the longest series add empty categories.", control = Text }
            , { name = "dates", type_ = "List Date", description = "The categories of a line or bar chart when they are days, one per value, in the order of the values. The axis writes them as short as a label can be (`21 Sep` in English, `21. sep.` in Norwegian, see `Format.dateShort`), so that eight of them fit under a half page chart, and the tooltip and the text alternative write the whole date. `categories` an", control = Example }
            , { name = "height", type_ = "Int", description = "The height of the plot in pixels, kept between 16 and 1200. The defaults are 220 for line and bar charts, a height that follows the number of categories for horizontal bars, and 28 for a sparkline. Donut, gauge and meter have a fixed shape (see `width`).", control = Number }
            , { name = "width", type_ = "Int", description = "The width in pixels of a sparkline, donut or gauge, kept between 24 and 1200. Without it they take what the container gives them (sparkline: 100%, donut: 168px, gauge: 200px), and never more than the container. Line charts, bar charts and meters always fill their container.", control = Number }
            , { name = "area", type_ = "Flag", description = "Fills the area under the line, for every series of a line chart and for a sparkline. A filled area reads as an amount counted from zero, so the value axis of a line chart with `area` includes zero.", control = Choice [ "Enabled", "omit" ] }
            , { name = "pointsOnHover", type_ = "Flag", description = "Shows the markers of a line chart only while the pointer (or the keyboard focus, see `onSelect`) is on a category, for a calm line through many points. By default every point has a marker for up to 40 categories, and beyond that markers are shown on hover only. The markers of a `dashed` series are always on hover only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "stacked", type_ = "Flag", description = "Stacks the series of a bar chart on top of each other instead of side by side. Positive values stack upward from zero and negative values downward. The tooltip and the data table get the total of each category.", control = Choice [ "Enabled", "omit" ] }
            , { name = "horizontal", type_ = "Flag", description = "Horizontal bars: good for long category names and many categories. The height of the chart follows the number of categories, unless you set `height`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "valueLabels", type_ = "Flag", description = "Prints the value at the end of each bar (the total, for stacked bars). It is only shown when there is room: up to 24 bars in a vertical chart and up to 60 in a horizontal one.", control = Choice [ "Enabled", "omit" ] }
            , { name = "legend", type_ = "Flag", description = "Shows the legend of a line or bar chart even for a single series. By default a line or bar chart shows it for two or more series, and a donut always shows it. `legend` and `hideLegend` replace each other.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hideLegend", type_ = "Flag", description = "Leaves out the legend of a line, bar or donut chart, for a chart whose series or slices are named in some other way (a title that says it, a table next to it). Without the legend of a donut the slices are only named in the tooltips and in the hidden data table. A donut with `onSelect` keeps its legend buttons, because they are the keyboard path to ", control = Choice [ "Enabled", "omit" ] }
            , { name = "yMin", type_ = "Float", description = "Fixes the lower end of the value axis (the horizontal axis of a horizontal bar chart). Values below it are cut off at the edge of the plot. A limit that cannot make an axis, such as a minimum above the maximum, is ignored and the axis follows the data.", control = Number }
            , { name = "yMax", type_ = "Float", description = "Fixes the upper end of the value axis (the horizontal axis of a horizontal bar chart). Values above it are cut off at the edge of the plot. A limit that cannot make an axis is ignored and the axis follows the data.", control = Number }
            , { name = "includeZero", type_ = "Flag", description = "Starts the value axis of a line chart at zero (or ends it there, for values below zero). By default the axis of a line chart follows the data, unless the chart has an `area`. The axis of a bar chart always includes zero: a bar is read by its length.", control = Choice [ "Enabled", "omit" ] }
            , { name = "valueFormat", type_ = "(Float -> String)", description = "How a value is written on the axis, in the tooltips, the value labels and the data table, and in the text of a donut, gauge or meter. Use it for currencies, percentages and other units. When it is set, `unit` is not added.", control = Example }
            , { name = "unit", type_ = "String", description = "A unit written after the value, separated by a non-breaking space: \"USD\". It is added in the tooltips, the data table, the legend of a donut and the value text of a gauge or meter, but not on the axis. It is ignored when `valueFormat` is set.", control = Text }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (\"No data to show\", \"Line chart\", \"Loading chart\" and so on) and of the number format. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "tone", type_ = "Tone", description = "Colors the chart by meaning instead of by palette: the first series of a line or bar chart (the other series keep their palette colors), a sparkline, and a gauge or meter that has no `thresholds`. The default is `Primary` (blue).", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button of a chart from a `Remote` (`lineRemote` and its sisters) that failed, and by the marker of old data. The button is only shown when the problem is worth retrying (see `Klar.Remote.isRetryable` in [Klar.Remote](Klar-Remote)); a sparkline is too small for a message and has none.", control = Example }
            , { name = "onSelect", type_ = "(Int -> msg)", description = "Makes every category of a line or bar chart, and every slice of a donut, a button that sends this message with its position in the lists you gave, counted from 0: the category of `categories` (or `dates`), or the segment of the list given to `donut`. Use it to drill down: \"click the bar of warehouse B to see its late orders\".", control = Example }
            , { name = "emptyText", type_ = "String", description = "The text of the empty state, shown when there is nothing to draw: no series, no values, or a donut whose slices add up to 0. The default is \"No data to show\". A sparkline uses it as its accessible label. A gauge and a meter always have a value, so they never show it.", control = Text }
            , { name = "centerLabel", type_ = "String", description = "The big text in the middle of a donut or gauge. The default is the total of a donut and the value of a gauge. A meter writes it as its value text above the scale.", control = Text }
            , { name = "centerCaption", type_ = "String", description = "A small text under the center value of a donut or gauge: \"orders\". On a gauge it is also part of the accessible name (which says \"Gauge\" without it).", control = Text }
            , { name = "range", type_ = "Float -> Float", description = "The scale of a gauge or meter: its lowest and its highest value. The default is 0 to 100. If the first number is the larger, the two are swapped.", control = Example }
            , { name = "thresholds", type_ = "List ( Float, Tone )", description = "Zones of a gauge or meter: the upper limit of each zone and its meaning. The zone the value falls in colors the gauge and the value of the meter. A meter also draws every zone on its track, and a gauge a tick at each limit.", control = Example }
            , { name = "maxLabels", type_ = "Int", description = "At most this many category labels on the axis of a line or bar chart. The rest are left out evenly (every second, third ... label is shown), and the label of the last category is always there. The default is 12 for a line chart and a vertical bar chart; a horizontal bar chart names every bar that has a row of at least 14 pixels. The value is kept b", control = Number }
            ]

        "Timeline" ->
            [ { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the clock times and of the day an event belongs to, and of \"Old data from 14:05\". Without it the times are written in UTC and end in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (\"Show details\", \"Load more\", \"Today\", \"Yesterday\", the footer and so on) and of the dates. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "now", type_ = "Time.Posix", description = "The current time. It lets the day headings say \"Today\", \"Yesterday\" and \"Tomorrow\" and the tooltip of each time add how long ago it was (\"3 hours ago\"). Without it the headings always show the full date. The timeline does not read the clock itself: keep the value in your model and update it, for example with `Time.every`.", control = Number }
            , { name = "compact", type_ = "Flag", description = "Less space: a dot as the marker, one line per event with the description after the title, and the time at the right. Good for side panels. Details still fold out below the line.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ungrouped", type_ = "Flag", description = "One list, with no day headings. The time of an event is still shown, but its date is only in the tooltip.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the timeline, for example \"Order history\". It makes the timeline a labelled region, so give each timeline on a page its own name.", control = Text }
            , { name = "headingLevel", type_ = "Int", description = "The level, 1 to 6, of the heading of each day (`h3` by default; other numbers are moved into that range). The headings must follow the ones of the page: a timeline directly under the `h1` of a page takes 2, one in a card with an `h2` title keeps 3.", control = Number }
            , { name = "id", type_ = "String", description = "The DOM id of the timeline, which then takes focus from a command in every state (loading, failed, loaded). The \"Try again\" button of a failure is replaced when the request starts again, and focus would fall back to the page; call [`Klar.focus`](Klar#focus) with this id in the same `update` branch. The id must be unique on the page.", control = Text }
            , { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button of a timeline from a `Remote` (`viewRemote`) that failed, and by the marker of old data. The button is only shown when the problem is worth retrying (see `Klar.Remote.isRetryable` in [Klar.Remote](Klar-Remote)). A failed next page has its own retry button, which sends the message of `loadMore`.", control = Example }
            , { name = "loadMore", type_ = "msg -> Remote Bool", description = "Adds the footer under the events: a \"Load more\" button that sends the message, and a status text next to it. The `Remote Bool` is the request for the next page, and its `Bool` says whether there is more after the events shown:", control = Example }
            , { name = "total", type_ = "Int", description = "How many events there are in all, when the backend says so: the footer then says \"Showing 20 of 340 events\". Without it the footer counts only the events shown.", control = Number }
            , { name = "emptyTitle", type_ = "String", description = "The title of the empty state, shown when there are no events. The default is \"No events\".", control = Text }
            , { name = "emptyDescription", type_ = "String", description = "A line of explanation under the title of the empty state, such as what creates the first event. Default: none.", control = Text }
            , { name = "maxHeight", type_ = "Int", description = "Makes the timeline, footer included, scroll inside itself when it is taller than this many pixels: for a log in a side panel. Default: no limit.", control = Number }
            , { name = "skeletonRows", type_ = "Int", description = "How many placeholder events to show while loading. The default is 4; the value is kept between 1 and 20.", control = Number }
            ]

        "Avatar" ->
            [ { name = "size", type_ = "Size", description = "The size of the avatar: `Small` is 22px, `Medium` 30px (the default) and `Large` 40px. For 18px and 64px see `extraSmall` and `extraLarge`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "extraLarge", type_ = "Flag", description = "A 64px avatar, for profile headers and the top of a page.", control = Choice [ "Enabled", "omit" ] }
            , { name = "extraSmall", type_ = "Flag", description = "An 18px avatar, for a byline or a dense table cell.", control = Choice [ "Enabled", "omit" ] }
            , { name = "image", type_ = "String", description = "The URL of a picture, which covers the avatar. The initials stay behind it, so something readable remains if the picture cannot be loaded. It has no effect in a `group`, where every entry has its own picture.", control = Text }
            , { name = "icon", type_ = "Icon", description = "An icon instead of the initials, for systems, rooms and organizations. Often combined with `square`. In a `group` it applies to every avatar.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "status", type_ = "Status", description = "A small dot in the corner that shows the status. The status is also added to the accessible name (\"Grace Hopper, online\"). It has no effect in a `group`.", control = Choice [ "online", "away", "busy", "offline" ] }
            , { name = "square", type_ = "Flag", description = "A rounded square instead of a circle. Use it for things that are not people, such as organizations, systems and warehouses.", control = Choice [ "Enabled", "omit" ] }
            , { name = "decorative", type_ = "Flag", description = "Hides the avatar from screen readers. Use it when the name is written out right next to the avatar. On a `group` it hides the whole group: the avatars, the group itself and the \"+N\" bubble.", control = Choice [ "Enabled", "omit" ] }
            , { name = "maxShown", type_ = "Int", description = "How many avatars `group` shows before it folds the rest into a \"+N\" bubble. The default is 4, and the smallest value is 1.", control = Number }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the status in the accessible name of an avatar (\"online\", \"away\" ...) and the accessible names of a `group` and its \"+N\" bubble. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "JsonViewer" ->
            [ { name = "toolbar", type_ = "Flag", description = "Shows \"Expand all\" and \"Collapse all\" buttons above the tree. There is no toolbar by default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "rootLabel", type_ = "String", description = "A name for the root node, shown as its key: `\"response\": { ... }`.", control = Text }
            , { name = "maxDepth", type_ = "Int", description = "Objects and arrays nested deeper than this are shown as `{ ... }` or `[ ... ]` and cannot be opened. The default is 12, and the value is kept between 1 and 100.", control = Number }
            , { name = "maxItems", type_ = "Int", description = "How many entries of one object or array are shown before a \"Show N more\" row. The default is 100, and the value is kept between 5 and 5000.", control = Number }
            , { name = "maxStringLength", type_ = "Int", description = "Strings longer than this many characters are cut and end in \"...\", followed by \"Show all\": a click on it, or Enter on the row, shows the whole string. The tooltip has the start of the whole string (at most 4000 characters). The default is 140, and the value is kept between 10 and 5000.", control = Number }
            , { name = "maxHeight", type_ = "Int", description = "Scrolls inside the viewer when the tree gets taller than this many pixels. By default the viewer grows with its content. The keyboard scrolls it by moving from row to row: the row with the focus is always scrolled into view.", control = Number }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the tree, for example \"API response\". The default is \"JSON\". Give one when the page has more than one viewer.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the toolbar buttons, the \"Show N more\" row, the counts of keys and items, and the messages. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "RuleBuilder" ->
            [ { name = "fields", type_ = "List (Field row)", description = "What the rules can talk about: the fields the user can pick for a condition, made with `Rule.textField` and the other field functions. The first field is the one a new condition starts with. The default is no fields.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the builder's own text: buttons, issue messages, the summary sentence. The default is `Locale.default`, which is `Locale.en`. Field labels and choices come from the application.", control = Choice [ "en", "nb" ] }
            , { name = "matchCount", type_ = "Remote Int", description = "How many rows the rule matches, shown next to the summary as \"1,482 matches\". Give `Remote.Loaded n` for a count you have (`Rule.matches`), or the `Remote` of a count that takes time:", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale" ] }
            , { name = "totalCount", type_ = "Int", description = "The number of rows before filtering. With a `matchCount` the count reads \"1,482 of 3,000 matches\". Without a `matchCount` nothing is shown.", control = Number }
            , { name = "onRetry", type_ = "msg", description = "The message of the retry button that a failed or old `matchCount` shows. Without it there is no retry button.", control = Example }
            , { name = "today", type_ = "Date", description = "Today's date, for the date pickers of date fields: it marks the day, powers their \"Today\" button and completes short input. It does not change what a rule matches; give the same date to `Rule.matches`.", control = Text }
            , { name = "json", type_ = "Flag", description = "Adds a \"Show JSON\" button to the toolbar. It opens the rule as JSON (`Rule.encode`, indented) with a \"Download\" button that saves it as `rule.json` (`regel.json` in Norwegian) through `File.Download`, so `update` returns the command that does it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "importJson", type_ = "Flag", description = "Adds an \"Import JSON\" button to the toolbar: the user pastes a rule as JSON (the format of `Rule.decoder`) and applies it. Text that is not valid JSON, or not a rule, gives a message. So does a rule with more levels of groups than `maxDepth` allows: it is refused, never trimmed, because cutting groups off would change what the rule means. A valid r", control = Choice [ "Enabled", "omit" ] }
            , { name = "maxDepth", type_ = "Int", description = "How many levels of groups a rule may have, counting the outermost group. The default is 4, and values below 1 count as 1. Groups on the deepest level get no \"Add group\" button, and an imported rule that is deeper is refused. A rule that the application gives with `setRule` is shown as it is.", control = Number }
            , { name = "ariaLabel", type_ = "String", description = "The name of the builder for screen readers, when it has no visible `label`. The default is \"Rule builder\".", control = Text }
            , { name = "label", type_ = "String", description = "A visible label above the builder, as a form field has; it also names the builder for screen readers. The default is no label.", control = Text }
            , { name = "hint", type_ = "String", description = "A line of help under the builder (after its footer, where a form field puts its hint), read with the builder by screen readers.", control = Text }
            , { name = "error", type_ = "String", description = "A problem with the rule as a whole, in red under the builder, such as \"Add a condition\" for a required rule. The problems of single conditions are the builder's own (see `issues`).", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, with `Nothing` for no problem.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the rule as required: a `*` after the label. The builder checks nothing itself.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "A text after the label of a rule that is not required, such as \"(optional)\".", control = Text }
            , { name = "actions", type_ = "List (Html msg)", description = "Extra buttons at the end of the builder's toolbar, such as a \"Save rule\" button. They are your own `Html`, and their messages are yours.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            ]

        "FilterBar" ->
            [ { name = "fields", type_ = "List (Field row)", description = "What can be filtered on: the fields the user can pick in the editor, made with `Rule.textField` and the other field functions. The default is no fields.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the bar's own text: buttons, hints and the words that say how the chips are combined. The default is `Locale.default`, which is `Locale.en`. Field labels and choices come from the application.", control = Choice [ "en", "nb" ] }
            , { name = "quick", type_ = "List ( String, Rule )", description = "Ready-made filters, shown as toggle pills in front of the chips. Each one is a name and a `Rule`.", control = Example }
            , { name = "matchCount", type_ = "Remote Int", description = "How many rows the filters let through, shown at the end of the bar as \"1,482 matches\". Give `Remote.Loaded n` for a count you have (`Rule.matches`), or the `Remote` of a count that takes time:", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale" ] }
            , { name = "totalCount", type_ = "Int", description = "The number of rows before filtering. With a `matchCount` the count reads \"1,482 of 3,000 matches\". Without a `matchCount` nothing is shown.", control = Number }
            , { name = "onRetry", type_ = "msg", description = "The message of the retry button that a failed or old `matchCount` shows. Without it there is no retry button.", control = Example }
            , { name = "today", type_ = "Date", description = "Today's date, for the date picker in the editor: it marks the day, powers its \"Today\" button and completes short input. It does not change what the filters match; give the same date to `Rule.matches`.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The name of the bar for screen readers. The default is \"Filters\".", control = Text }
            , { name = "addLabel", type_ = "String", description = "The text of the add button. The default is \"Add filter\".", control = Text }
            ]

        "SavedViews" ->
            [ { name = "currentRule", type_ = "Rule", description = "The rule the application shows now. It is what \"Save current view ...\" saves, and what the active view is compared with: the view is marked \"modified\" when the two differ (ignoring node ids). Without it the list can only apply views, not save them.", control = Example }
            , { name = "remote", type_ = "Remote a", description = "Takes loading, failure, refreshing and old data from the `Remote` of the request that brings the views; the views themselves are the ones of `setViews`, as always. While nothing has come the list says that it is loading (not \"No saved views yet\"), a failure with no views to show says what went wrong with a retry (`onRetry`), and views that are `Kep", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale" ] }
            , { name = "onRetry", type_ = "msg", description = "The message of the \"Try again\" button, shown when loading the views failed (and the problem is worth retrying, see `Remote.isRetryable`). While the views load (the first time, or again after \"Try again\") the list says it is loading, with no button; focus moves from the button to that status, so it stays in the popup.", control = Example }
            , { name = "currentQuery", type_ = "Table.Query", description = "The query of the table next to the filters, `Table.query model.table`. A view that is saved holds it with the rule (the page is left out), and the active view is \"modified\" when its query differs from it. Without it views hold only the rule.", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the component's own text: the button, the list and its messages. The default is `Locale.default`, which is `Locale.en`. The names and notes of the views come from the application.", control = Choice [ "en", "nb" ] }
            , { name = "label", type_ = "String", description = "The button text when no view is active. The default is \"Views\". While a view is active the button shows its name instead.", control = Text }
            , { name = "alignEnd", type_ = "Flag", description = "Opens the list towards the left: its right edge lines up with the right edge of the button. Use it when the button sits at the right edge of the page.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "The size of the button, a [Klar.Theme](Klar-Theme) `Size`. The default is `Medium`; `Small` matches the controls of a filter bar.", control = Choice [ "Small", "Medium", "Large" ] }
            ]

        "RemoteView" ->
            [ { name = "onRetry", type_ = "msg", description = "The message sent by the \"Try again\" button, in the failure and in the marker of old data. The button is only shown for problems worth retrying (see `Remote.isRetryable`).", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the body, which must be unique on the page. The body is one element in every state (loading, failed, nothing to show, old data, data); with an id it can take focus, so that `Klar.focus` has a place to put it. There is no id by default.", control = Text }
            , { name = "loadingLabel", type_ = "String", description = "What is loading, as screen readers should hear it: \"Loading order\". The default is \"Loading\".", control = Text }
            , { name = "skeleton", type_ = "Html msg", description = "The placeholder shown while loading, drawn with [Klar.Skeleton](Klar-Skeleton). The default is a title line and a few lines of text.", control = Text }
            , { name = "emptyState", type_ = "List (EmptyState.Attribute msg)", description = "What the body shows when the data is there but your function draws nothing for it (returns `[]`): an [Klar.EmptyState](Klar-EmptyState). The default is a compact one that says \"Nothing to show\"; your attributes are applied after it, so yours win. Return `[]` for an empty result and let the body say so:", control = Example }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (\"Loading\", \"Try again\", \"Old data from\", \"Nothing to show\"). The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "AiReview" ->
            [ { name = "onSubmit", type_ = "(List (Decision id) -> msg)", description = "Adds the explicit save action, receiving all decisions, including rejections.", control = Example }
            , { name = "saving", type_ = "Bool", description = "Disables editing and submission during a server write. Defaults to `False`.", control = Choice [ "True", "False" ] }
            , { name = "errorMaybe", type_ = "Maybe String", description = "A failed server write. Keeps every local choice and note. Absent by default.", control = Text }
            , { name = "discussion", type_ = "(id -> String -> Html msg)", description = "Content beneath each proposal, receiving its application id and revision. Use a separate CommentThread state for each pair. Absent by default.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retries initial load or refresh failures. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Language of built-in text. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Timestamp formatting of retained data. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "AiChat" ->
            [ { name = "onSend", type_ = "(Submission -> msg)", description = "Adds the composer and an explicit Send button. Receives an immutable draft.", control = Example }
            , { name = "onStop", type_ = "msg", description = "Requests that the application cancel the active server run. Absent by default.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry action for failed history or a failed/interrupted generation. The application decides which request to repeat. Absent by default.", control = Example }
            , { name = "maxLength", type_ = "Int", description = "Maximum prompt length, at least one character. Defaults to 8000. Over-limit input remains visible and is never truncated.", control = Number }
            , { name = "content", type_ = "(id -> Html msg)", description = "Structured content beneath a message, receiving its application id. Embed AiReview, tables, charts or JsonViewer here. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Language of built-in text. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Retained-data timestamp formatting. Defaults to `Settings.default`.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "UploadQueue" ->
            [ { name = "accept", type_ = "List String", description = "Allowed extensions (`.pdf`), MIME types or groups (`image/*`) for staging. Defaults to all file types. Native selection and drops use the same rules.", control = Text }
            , { name = "maxSize", type_ = "Int", description = "Maximum staged file size in bytes, inclusive. No limit by default. A negative limit accepts no files; it is never silently converted into an unlimited value.", control = Number }
            , { name = "maxFiles", type_ = "Int", description = "Maximum accepted files in one staged batch, not the length of queue history. No limit by default. A limit of one uses FileDrop's replace-on-next-choice mode.", control = Number }
            , { name = "disabled", type_ = "Bool", description = "Disables file selection and every action while `True`. Statuses stay visible. Defaults to `False`.", control = Choice [ "True", "False" ] }
            , { name = "onStart", type_ = "(id -> msg)", description = "Adds a start action to pending transfers. The callback receives the application id.", control = Example }
            , { name = "onStartAll", type_ = "(List id -> msg)", description = "Adds a bulk start action sending only pending ids in queue order. Disabled when none are pending; retries never join this action.", control = Example }
            , { name = "onRetry", type_ = "(id -> msg)", description = "Adds retry to retryable failures and confirmed cancellations. Nothing retries automatically, and retrying sends only the application's upload id.", control = Example }
            , { name = "onCancel", type_ = "(id -> msg)", description = "Adds a cancel request to active transfers. Keep the transfer active until your transport confirms cancellation or completion.", control = Example }
            , { name = "onRemove", type_ = "(id -> msg)", description = "Adds removal to pending and terminal transfers. Active transfers must be cancelled before removal, so no running request is silently forgotten.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Built-in text and number language. Defaults to English.", control = Choice [ "en", "nb" ] }
            ]

        "WorkflowNode" ->
            [ { name = "locale", type_ = "Locale", description = "Built-in language, English by default.", control = Choice [ "en", "nb" ] }
            , { name = "onSelect", type_ = "msg", description = "Make the node a keyboard-accessible button that sends this message.", control = Example }
            , { name = "selected", type_ = "Bool", description = "Mark the inspected node, false by default.", control = Choice [ "True", "False" ] }
            , { name = "status", type_ = "String", description = "Host-supplied, localized status text, empty by default.", control = Text }
            , { name = "detail", type_ = "String", description = "Host-supplied summary, such as attempt or artifact count.", control = Text }
            ]

        "WorkflowBuilder" ->
            [ { name = "locale", type_ = "Locale", description = "Built-in language, English by default.", control = Choice [ "en", "nb" ] }
            , { name = "selected", type_ = "Maybe id", description = "Identifier of the inspected step, absent by default.", control = Example }
            , { name = "onSelect", type_ = "(id -> msg)", description = "Receive the identifier of a clicked step or connection destination.", control = Example }
            , { name = "onAdd", type_ = "(Kind -> msg)", description = "Receive a kind from the palette. Allocate an identifier in the application.", control = Example }
            , { name = "onChange", type_ = "(Definition id -> msg)", description = "Receive a complete edited definition. Save/version it in your application.", control = Example }
            , { name = "readOnly", type_ = "Bool", description = "Disable design mutations while keeping inspection available. Default false.", control = Choice [ "True", "False" ] }
            , { name = "id", type_ = "String", description = "Unique DOM id and prefix for inspector fields. Defaults to `workflow-builder`; set a distinct id for each editor on the same page. The root can receive focus.", control = Text }
            ]

        "WorkflowRun" ->
            [ { name = "locale", type_ = "Locale", description = "Built-in language, English by default.", control = Choice [ "en", "nb" ] }
            , { name = "selected", type_ = "Maybe id", description = "Node whose attempt results are expanded. The active node is used by default.", control = Example }
            , { name = "onSelect", type_ = "(id -> msg)", description = "Receive the inspected node identifier.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry a failed remote request; the host reloads the snapshot.", control = Example }
            , { name = "id", type_ = "String", description = "Unique focus target, including remote loading and failure states.", control = Text }
            ]

        "StateMachine" ->
            [ { name = "locale", type_ = "Locale", description = "Built-in language, English by default.", control = Choice [ "en", "nb" ] }
            , { name = "onTransition", type_ = "(String -> msg)", description = "Receive an enabled event name. The host validates and applies it.", control = Example }
            ]

        _ ->
            []


