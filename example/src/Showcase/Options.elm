            , { name = "readOnly", type_ = "Bool", description = "While `True` the field shows its value but does not let the user change it: the popup does not open, and there is no chevron or clear button. Unlike `disabled`, a read-only field can be focused. The two are independent; with both set the field is disabled. The default is `False`.", control = Choice [ "True", "False" ] }
