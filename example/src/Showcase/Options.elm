            , { name = "size", type_ = "Size", description = "The size of the field, a `Size` from [Klar.Theme](Klar-Theme). Default: `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text (placeholder, button labels, error messages, names of months and weekdays) and the format in which the field shows a date: `2026-10-20` in English, `20.10.2026` in Norwegian. It also decides which order is tried first for digits-only input such as `20102026`. The default is `Locale.default`, which is English; see [", control = Choice [ "en", "nb" ] }
            , { name = "today", type_ = "Date", description = "Today, supplied by the application (the library never reads the clock). It marks the day in the calendar, powers the \"Today\" button (which picks today and closes the calendar), completes the short forms `20.10`, `t`, `+3` and `-7`, and decides how a two-digit year is read.", control = Text }
            , { name = "min", type_ = "Date", description = "The earliest date that can be chosen or typed. A typed date before it shows \"The date cannot be before\" followed by the limit, and the calendar disables the earlier days. Default: no limit.", control = Text }
            , { name = "max", type_ = "Date", description = "The latest date that can be chosen or typed. A typed date after it shows \"The date cannot be after\" followed by the limit, and the calendar disables the later days. Default: no limit.", control = Text }
            , { name = "disabledWhen", type_ = "(Date -> Bool)", description = "Dates that cannot be used, such as weekends or public holidays. The calendar shows them disabled, and a typed one shows \"The date is not available\". Default: every date is allowed.", control = Example }
            , { name = "markers", type_ = "List Calendar.Marker", description = "Marks on days in the calendar, such as deliveries or deadlines. Make them with `Calendar.dot` and `Calendar.count` from [Klar.Calendar](Klar-Calendar). Default: none.", control = Example }
            , { name = "weekNumbers", type_ = "Flag", description = "Shows ISO 8601 week numbers in the calendar. Default: off.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignEnd", type_ = "Flag", description = "Aligns the right edge of the calendar popup with the right edge of the field, instead of the left edges. Use it for a field near the right side of the page, so that the popup does not run out of the window.", control = Choice [ "Enabled", "omit" ] }
