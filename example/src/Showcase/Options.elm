            , { name = "min", type_ = "Time", description = "The earliest time that can be chosen or typed. The list starts at the first time of its step at or after it, and a typed time before it shows \"The time cannot be before\" followed by the limit. A record outside 00:00 to 23:59 is moved to the nearest time of day. Default: 00:00.", control = Example }
            , { name = "max", type_ = "Time", description = "The latest time that can be chosen or typed. The list stops at the last time of its step at or before it, and a typed time after it shows \"The time cannot be after\" followed by the limit. A record outside 00:00 to 23:59 is moved to the nearest time of day. Default: 23:59.", control = Example }
