            , { name = "ariaDisabled", type_ = "Bool", description = "Dimmed and unclickable like `disabled`, but the button stays in the tab order and keeps the keyboard focus (`aria-disabled`). Use it for a button that becomes unavailable while the user is on it, such as \"Load more\" after the last page, and for one that a [Klar.Tooltip](Klar-Tooltip) explains: it still gets the pointer and the focus that show the t", control = Choice [ "True", "False" ] }
            , { name = "block", type_ = "Flag", description = "Full width: the button fills its container.", control = Choice [ "Enabled", "omit" ] }
            , { name = "onClick", type_ = "msg", description = "The message sent when the button is clicked (or activated with the keyboard). Nothing is sent while the button is `loading`, `disabled` or `ariaDisabled`.", control = Example }
            , { name = "submit", type_ = "Flag", description = "Makes this the submit button of the surrounding `form`. Without it a button has the type `button` and never submits anything.", control = Choice [ "Enabled", "omit" ] }
            , { name = "href", type_ = "Link.Target", description = "Makes the button an anchor (`<a href>`) that leads to the target: a page of the application (`Link.internal`), another site (`Link.external`, which opens in a new tab) or a file to save (`Link.download`). See [Klar.Link](Klar-Link).", control = Text }
            , { name = "newTab", type_ = "Flag", description = "Opens a link made with `href` in a new tab (`target=\"_blank\"`, with `rel=\"noopener noreferrer\"`), with the text \"(opens in a new tab)\" for screen readers in the language of `locale`. A link to another site (`Link.external`) does this without it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the button. Needed to return focus to it, for example with `Modal.open`.", control = Text }
            , { name = "title", type_ = "String", description = "The native tooltip (the `title` attribute). For a keyboard-friendly hint use `Klar.Tooltip` instead. On an `iconOnly` button it is the text of the tooltip that the button has already, instead of the label.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name, when it differs from the visible label.", control = Text }
            , { name = "pressed", type_ = "Bool", description = "Makes the button a toggle and says whether it is on (`aria-pressed`). In Windows high contrast a button that is on gets a frame.", control = Choice [ "True", "False" ] }
            , { name = "expanded", type_ = "Bool", description = "For buttons that open a menu or a popup: says whether it is open (`aria-expanded`).", control = Choice [ "True", "False" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: \"(opens in a new tab)\", which screen readers read after the label of a link that opens in a new tab. The default is `Locale.default`, which is `Locale.en`.", control = Choice [ "en", "nb" ] }
            , { name = "htmlAttrs", type_ = "List (Html.Attribute msg)", description = "An escape hatch for raw HTML attributes such as extra event handlers or `data-` attributes. Other components that build on buttons use it.", control = Text }
            ]

        "Menu" ->
            [ { name = "label", type_ = "String", description = "Text on the button that opens the menu, followed by a small down arrow. It is not used with `kebab`; without a label or `kebab` the button has no accessible name. The menu is named after its button for screen readers.", control = Text }
