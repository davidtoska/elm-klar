        "Transfer" ->
            [ { name = "options", type_ = "Ids id -> List (Option id)", description = "The items to choose from, as options of [Klar.Select](Klar-Select), with the `Ids` that write their values as keys. The default is no items. Use `options` or `remote`, not both: the later one wins.", control = Example }
            , { name = "remote", type_ = "Ids id -> Remote (List (Option id))", description = "The items from the backend, as a `Remote` (see [Klar.Remote](Klar-Remote)). \"Available\" shows loading rows while the data is `Loading` or `NotAsked`, a compact error with a retry button on `Failed` (see `onRetry`), and the items on `Loaded`. Items that are `Kept` stay on screen and can be moved: \"Available\" is dimmed and busy while they are refresh", control = Example }
            , { name = "onRetry", type_ = "msg", description = "The message to send when the user presses the \"Try again\" button of the error shown when the items (`remote`) failed to load. The button appears only for problems that are worth retrying (network trouble, timeouts, server errors).", control = Example }
            , { name = "titles", type_ = "{ available : String, chosen : String }", description = "The titles of the two lists. The default is \"Available\" and \"Chosen\" (in the language of `locale`). The titles name the lists for screen readers, label the buttons and are used in the announcement after a move (\"3 items moved to “In the promotion”\"), in quotes wherever a title is part of a sentence.", control = Example }
            , { name = "order", type_ = "Order", description = "Sets the order of the chosen ids, see `Order`. The default is `sourceOrder`.", control = Choice [ "sourceOrder", "movedOrder" ] }
            , { name = "label", type_ = "String", description = "The label above the field. It names the group for screen readers.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keeps the label for screen readers but does not draw it. It needs a `label`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A short help text under the field. Screen readers read it with the group.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the field. The message is announced to screen readers when it appears.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Nothing` shows no error. Handy with a validation result.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label. It does not validate anything; show a problem with `error`, for example when `values` is empty.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "A text after the label of a field that is not `required`, such as \"(optional)\".", control = Text }
            , { name = "valueText", type_ = "(id -> String)", description = "How to write a chosen id that the items do not have, for example a product that was removed. Without it the row says \"Unknown value\" (or the label that the component saw when the id was moved).", control = Example }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed and nothing can be marked or moved. The value is kept. Pass a field of your model, for example while a form is saving. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the field shows its lists but does not let the user change them: the lists can still be scrolled and read, also with the keyboard (the arrow keys, Home, End, the Page keys and the letters move the highlight; nothing is marked or moved), and they say `aria-readonly`. Unlike `disabled` it is not dimmed. The two are independent; with both", control = Choice [ "True", "False" ] }
            , { name = "visibleRows", type_ = "Int", description = "How many rows each list shows before it scrolls. The default is 10; numbers below 4 or above 30 are brought into that range.", control = Number }
