            , { name = "platform", type_ = "Kbd.Platform", description = "The keyboard that the shortcuts of `withShortcut` are drawn for: `Kbd.pc` (the default: Ctrl, Alt, Shift) or `Kbd.mac` (⌘ ⌥ ⇧). See [`Kbd.platformFromUserAgent`](Klar-Kbd#platformFromUserAgent).", control = Example }
