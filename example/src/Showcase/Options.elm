            , { name = "name", type_ = "String", description = "The `name` attribute of the text input, for a plain HTML `form`. The value that is sent is the text in the field. Default: none.", control = Text }
            ]

        "DateTimePicker" ->
            [ { name = "label", type_ = "String", description = "The label above the two fields. It names the group that holds them, and the two inputs are named after it for screen readers (\"Pick-up time, date\" and \"Pick-up time, time\"; \"Date\" and \"Time\" without a label). Give the control a label, or hide it with `labelHidden`.", control = Text }
