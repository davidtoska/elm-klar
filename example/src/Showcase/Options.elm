            , { name = "maxVisibleChips", type_ = "Int", description = "How many chosen nodes a multiple field writes out as chips. The default is 3. When more nodes are chosen, the field shows one chip \"40 selected\" instead, which has the remove button of the whole choice, so that the field does not grow with the choice. The most is 20.", control = Number }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\", for the top level (`remote`) and for lazy nodes. Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
