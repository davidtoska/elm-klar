forComponent : String -> List Option
forComponent component =
    case component of
        "Layout" ->
            [ { name = "gap", type_ = "Int", description = "The space between the children, on the 4px scale: `gap 2` is 8px. The default is 3 (12px). It applies to `stack`, `row` and `grid`.", control = Number }
            , { name = "padding", type_ = "Int", description = "The space between the edge of the element and its children, on the same scale as `gap`. The default is 0 (none).", control = Number }
            , { name = "alignStart", type_ = "Flag", description = "Aligns the children at the start of the cross axis: at the top of a row, at the left edge of a stack. On a `container` it makes a narrow column at the left edge of its parent (see `container`).", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignCenter", type_ = "Flag", description = "Centers the children on the cross axis: vertically in a row, horizontally in a stack. This is the default of a `row`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignEnd", type_ = "Flag", description = "Aligns the children at the end of the cross axis: at the bottom of a row, at the right edge of a stack.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignStretch", type_ = "Flag", description = "Stretches the children to fill the cross axis: as tall as the row, as wide as the stack. This is the default of a `stack`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignBaseline", type_ = "Flag", description = "Lines up the first line of text of every child, which looks right when the children have different sizes. Rows only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "justifyCenter", type_ = "Flag", description = "Centers the children along the main axis: horizontally in a row, vertically in a stack that is taller than its content. Rows and stacks only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "justifyEnd", type_ = "Flag", description = "Packs the children at the end of the main axis: at the right end of a row, at the bottom of a stack that is taller than its content. Rows and stacks only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "justifyBetween", type_ = "Flag", description = "Spreads the children along the main axis, with the first at the start, the last at the end and the free space shared between them. Rows and stacks only. To push just one child away, use `spacer`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "wrap", type_ = "Flag", description = "Lets the children of a row continue on a new line when they do not fit instead of being squeezed. Rows only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "fill", type_ = "Flag", description = "Makes the element as wide as its parent.", control = Choice [ "Enabled", "omit" ] }
            , { name = "grow", type_ = "Flag", description = "Lets the element take the space that is left over in the `row` or `stack` it sits in. Give it to the part that should flex, such as the main column next to a fixed sidebar.", control = Choice [ "Enabled", "omit" ] }
            , { name = "width", type_ = "Int", description = "Gives the element a fixed width in pixels, and lets it keep that width in a `row` (it does not grow or shrink), so that the part next to it can `grow`: a tree, a filter panel or a list beside the main area. On a screen narrower than the width it shrinks to the width of its parent. At least 16 pixels.", control = Number }
            , { name = "fillRest", type_ = "Flag", description = "Makes a `stack` as tall as the room that is left in its parent, and hands that height on to its children: the way to give a `Table.fillHeight` a table that fills the rest of the page. Inside an `AppShell` the parent is the content area, so the stack is as tall as the window under the top bar; in a flex column of your own it takes what the other chi", control = Choice [ "Enabled", "omit" ] }
            , { name = "columns", type_ = "Int", description = "A `grid` with this many equal columns. There is always at least one column: 0 and negative numbers count as 1. If a grid has both `columns` and `minColumn`, `columns` wins.", control = Number }
            , { name = "minColumn", type_ = "Int", description = "A responsive `grid`: as many columns as fit, each at least this many pixels wide, sharing the free space between them. Columns that would be empty collapse (`auto-fit`), so two children in a wide grid share the whole row. On a screen narrower than one column there is a single column of full width. A grid with neither `columns` nor `minColumn` behav", control = Number }
            , { name = "columnSpan", type_ = "Int", description = "How many columns the element takes in the `grid` it sits in: a chart over two columns next to two narrow tiles. It is at least 1 and never more than the columns of the grid, so `columnSpan 4` in a grid of `columns 3` takes the whole row. A responsive grid (`minColumn`) changes its number of columns with the width, so there every element takes one c", control = Number }
            , { name = "maxWidth", type_ = "Int", description = "The maximum width of a `container`, in pixels. The default is 1440. Other layouts ignore it.", control = Number }
            , { name = "maxHeight", type_ = "Int", description = "Limits the height to this many pixels and scrolls the content that does not fit: a scroll area for lists and panels. It works on every layout. By default the layout grows with its content.", control = Number }
            , { name = "scroll", type_ = "Flag", description = "Scrolls the content that does not fit in the height the layout gets from its parent: with `fillRest` or `grow`, a panel beside a table that is as tall as the window and scrolls on its own. Like `maxHeight` (which scrolls by itself), the area takes the keyboard focus; give it an `ariaLabel`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the layout element: the target of `Klar.focus`, of a skip link or of an `aria-labelledby` of your own.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "A name that only a screen reader hears. It makes the layout a named region (`role=\"region\"`), which a screen reader lists with the landmarks of the page: use it for a scroll area (`maxHeight`, `scroll`), whose focus would otherwise land on an element with no name, and for a panel a person should be able to jump to. An empty text is no name.", control = Text }
            ]

        "Card" ->
            [ { name = "title", type_ = "String", description = "The title in the header, an `h2` unless you set another level with `headingLevel`. A card without a title, a subtitle or actions has no header.", control = Text }
            , { name = "headingLevel", type_ = "Int", description = "The level of the heading element of the title, from 1 to 6: `headingLevel 3` makes it an `h3`. The default is 2, the level under the `h1` of a [PageHeader](Klar-PageHeader). A number outside the range counts as the nearest level. Choose another level for a card inside a section that has its own `h2` (the card then takes 3): one below the heading of", control = Number }
            , { name = "subtitle", type_ = "String", description = "A smaller line under the title, such as a period or a count. An empty text is no subtitle.", control = Text }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons or links at the right end of the header. On a narrow card they move below the title.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "footer", type_ = "List (Html msg)", description = "A tinted strip below the body, such as a summary or a few buttons, laid out in a row that wraps. It starts at the left; a `Layout.spacer` pushes what comes after it to the right end. An empty list is no footer.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "flush", type_ = "Flag", description = "No padding around the body, so that a table, a list or a picture goes edge to edge. The header and the footer keep their padding.", control = Choice [ "Enabled", "omit" ] }
            , { name = "sunken", type_ = "Flag", description = "A light gray background instead of white, for less prominent content.", control = Choice [ "Enabled", "omit" ] }
            , { name = "raised", type_ = "Flag", description = "A subtle shadow, to lift the card off the page.", control = Choice [ "Enabled", "omit" ] }
            , { name = "accent", type_ = "Tone", description = "A colored strip along the left edge, to mark a status. `Neutral` is gray, `Primary` and `Info` are blue, and `Success`, `Warning` and `Danger` have colors of their own.", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the card. With a title, it also makes the card a named region, a landmark of the page: the title gets the id `<id>-title` and the card points at it with `aria-labelledby`. So give it only to the main cards of a page, the ones a person jumps between; a card does not need an id to be scrolled to or focused inside.", control = Text }
            ]

        "Button" ->
            [ { name = "content", type_ = "String", description = "The visible text passed to view. Reset to keep each example's label.", control = Text }
            , { name = "primary", type_ = "Flag", description = "The one main action of a page or dialog: solid blue. Use it once per view.", control = Choice [ "Enabled", "omit" ] }
            , { name = "secondary", type_ = "Flag", description = "The default look: white with a thin gray border.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ghost", type_ = "Flag", description = "A quiet button with no border until the pointer is over it. Good for toolbars, table rows and icon-only buttons.", control = Choice [ "Enabled", "omit" ] }
            , { name = "danger", type_ = "Flag", description = "A destructive action. On its own (or with `primary`) the button is solid red; with `secondary`, `ghost` or `link` it keeps that look and only the text (and the border of a `secondary` button) turns red.", control = Choice [ "Enabled", "omit" ] }
            , { name = "link", type_ = "Flag", description = "A button that looks like a link, for actions inside running text.", control = Choice [ "Enabled", "omit" ] }
            , { name = "small", type_ = "Flag", description = "A compact button, 26px high.", control = Choice [ "Enabled", "omit" ] }
            , { name = "large", type_ = "Flag", description = "A large button, 40px high, for the main action of an empty page or a form.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "Sets the size from a variable. The default is `Medium` (32px). `small` and `large` are shorthands.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "icon", type_ = "Icon", description = "An icon before the label.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "iconRight", type_ = "Icon", description = "An icon after the label, such as a chevron on a button that opens a menu.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "loading", type_ = "Bool", description = "While `True` the button shows a spinner instead of its icon, announces `aria-busy`, and ignores clicks. Pass a field of your model, so the button cannot be clicked twice while a request is on its way.", control = Choice [ "True", "False" ] }
