            , { name = "valueFormat", type_ = "(Float -> String)", description = "Your own way of writing a value. It replaces the number format and the unit, and its text is also what a screen reader reads (`aria-valuetext`). A range slider formats both numbers with it and joins them with a dash.", control = Example }
            , { name = "bubble", type_ = "Flag", description = "Shows the value in a small bubble above the thumb while the slider is hovered, focused or dragged. A range slider shows both values together over the middle of the filled part. The bubble is for the eyes only (`aria-hidden`).", control = Choice [ "Enabled", "omit" ] }
            , { name = "hideValue", type_ = "Flag", description = "Does not write the value as text above the track. Combine it with `bubble`, `ticks` or `marks`, or use it where the value is clear without it. A slider with neither a label nor a value has no line above the track at all.", control = Choice [ "Enabled", "omit" ] }
            , { name = "ticks", type_ = "Float", description = "A small tick mark every this many units, counted from `min`. Nothing is drawn when the number is not positive or when the range would hold more than 100 steps of it. The ticks are decoration (`aria-hidden`).", control = Number }
