            , { name = "size", type_ = "Size", description = "Sets the size from a variable. The default is `Medium` (32px). `small` and `large` are shorthands.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "icon", type_ = "Icon", description = "An icon before the text of the main part.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "loading", type_ = "Bool", description = "While `True` the main part shows a spinner instead of its icon, announces `aria-busy` and ignores clicks, and the arrow cannot open the menu. Both parts stay in the tab order (`aria-disabled`, not `disabled`), so a user who has just picked an item from the menu keeps the keyboard focus. Pass a field of your model, so the button cannot be clicked tw", control = Choice [ "True", "False" ] }
            , { name = "disabled", type_ = "Bool", description = "Turns both parts off: they are dimmed, send nothing and cannot open the menu, and screen readers hear that they are unavailable (`aria-disabled`). They stay in the tab order, so a split button that is disabled while the user is on it keeps the focus. A menu that is open stays open until it is closed. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "menuLabel", type_ = "String", description = "The accessible name of the arrow, which has no text. The default is \"More options for\" and the text of the main part (\"More options for Save\"), in the language of `locale`. Set it when the default does not fit, for example \"Save options\".", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, the accessible name of the arrow. The default is `Locale.default`, which is `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "Link" ->
            [ { name = "current", type_ = "Bool", description = "Says that the link leads to the page that the user is on (`aria-current=\"page\"` for screen readers; the text is a little heavier and not underlined). Give it a comparison from your model, so it follows the route:", control = Choice [ "True", "False" ] }
            , { name = "disabled", type_ = "Bool", description = "A destination the user may not visit now. The link has no `href`, so it cannot be followed, and screen readers find it as a link that is unavailable (`aria-disabled`). It stays in the tab order (`tabindex=\"0\"`), so that a link disabled while it has focus keeps it and a [Klar.Tooltip](Klar-Tooltip) around it can say why to a keyboard user. It is dra", control = Choice [ "True", "False" ] }
            , { name = "inline", type_ = "Flag", description = "A link in the middle of a sentence: in the link color, underlined (so it is not told apart by color alone), and in another color once the user has visited it. This is the default; it replaces `standalone`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "standalone", type_ = "Flag", description = "A link that stands on its own, such as a cell of a table, an item of a list or a line of a menu: in the link color without an underline until the pointer is over it, and without a color for visited links. It replaces `inline`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "truncate", type_ = "Flag", description = "Keeps the text on one line and ends it with an ellipsis when the link is wider than the room it has, and makes the whole text its native tooltip. Give the link a container with a width (a table cell with a width, a column of a grid), because a link that may grow as wide as it likes has nothing to be cut by.", control = Choice [ "Enabled", "omit" ] }
            , { name = "icon", type_ = "Icon", description = "An icon before the text. It is decoration: the text names the link. See [Klar.Icon](Klar-Icon).", control = Choice (List.map Icon.name Icons.all) }
            , { name = "id", type_ = "String", description = "The DOM id of the link, to give focus back to it, for example with `Modal.open`.", control = Text }
            , { name = "onClick", type_ = "msg", description = "Lets the application take over a click: `msg` is sent when the user clicks the link with the main mouse button and no modifier key, and the browser does not follow the link then. Ctrl, Cmd, Shift and Alt clicks and the middle button are left alone, so \"open in a new tab\" keeps working, and so does a link that the keyboard follows with Enter, which ", control = Example }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, \"(opens in a new tab)\", which screen readers read after the text of a link to another site. The default is `Locale.default`, which is `Locale.en`.", control = Choice [ "en", "nb" ] }
            ]

        "Kbd" ->
            [ { name = "platform", type_ = "Platform", description = "The keyboard to write the keys for. The default is `pc`.", control = Choice [ "pc", "mac" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the text that screen readers get and of the word between the steps of a sequence (\"then\"). The default is `Locale.default`, which is `Locale.en`. The caps themselves (`Ctrl`, `K`) are the same in every language.", control = Choice [ "en", "nb" ] }
            , { name = "small", type_ = "Flag", description = "Compact caps (16px) for a menu, a tooltip or a field that shows its shortcut at the end. The default is 20px.", control = Choice [ "Enabled", "omit" ] }
            , { name = "inline", type_ = "Flag", description = "Caps that follow the size of the surrounding text, for a key in a sentence or a paragraph: they do not make the line taller. This replaces `small`, and the other way round.", control = Choice [ "Enabled", "omit" ] }
            ]

        "Badge" ->
            [ { name = "content", type_ = "String", description = "The visible text passed to view. Reset to keep each example's label.", control = Text }
            , { name = "tone", type_ = "Tone", description = "The color of the badge: `Neutral` (gray, the default of `view`), `Primary` (the default of `count`) or `Info` (the accent color), `Success`, `Warning` or `Danger`.", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "solid", type_ = "Flag", description = "A background filled with the color of the tone instead of the default light tint, for a badge that has to stand out. A `count` is solid by default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "outline", type_ = "Flag", description = "A border in the color of the tone and no fill, instead of the default light tint (or, on a `count`, the solid fill).", control = Choice [ "Enabled", "omit" ] }
            , { name = "dot", type_ = "Flag", description = "A small dot before the text, in the color of the text. It has no effect on a `count`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "The size of the badge: `Small` (16px high), `Medium` (20px, the default) or `Large` (24px). A `count` is 16px, 18px or 22px.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "icon", type_ = "Icon", description = "A small icon before the text (after the `dot`, if there is one). It has no effect on a `count`.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "max", type_ = "Int", description = "The largest number a `count` writes out. A larger number shows as this number with a plus (\"99+\"), while the tooltip and screen readers get the exact number. The default is 99, and the smallest value is 1. It has no effect on `view`.", control = Number }
            , { name = "locale", type_ = "Locale", description = "How a `count` writes its number: with the thousands separator of the locale (\"1,280\" in English, \"1 280\" in Norwegian), in the badge, its tooltip and what screen readers hear. The default is `Locale.default`, which is English. It has no effect on `view` and `status`, whose text is yours.", control = Choice [ "en", "nb" ] }
            ]

        "Tag" ->
            [ { name = "content", type_ = "String", description = "The visible text passed to view. Reset to keep each example's label.", control = Text }
            , { name = "tone", type_ = "Tone", description = "The color of the tag: `Neutral` (gray, the default), `Primary` or `Info` (blue), `Success`, `Warning` or `Danger`.", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "color", type_ = "Color", description = "A small dot in a color from your data before the label, for a tag that stands for a row with a color (a status, a team). The tag keeps its tone; the label must say what the color says.", control = Text }
            , { name = "icon", type_ = "Icon", description = "A small icon before the label.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "onRemove", type_ = "msg", description = "Shows a small × button after the label that sends this message when it is pressed: a click, `Enter` or `Space`, or a fresh press of `Delete` or `Backspace` while the button has the focus. A held `Delete` or `Backspace` does not repeat: after the focus has moved to the next tag (`nextFocus`), the repeats would remove that one too, and the next, unti", control = Example }
            , { name = "removeId", type_ = "String", description = "The DOM id of the remove button, for moving the focus to it from your application (`Klar.focus`), for example to the next tag after one was removed, so that keyboard users do not lose their place (see `nextFocus`).", control = Text }
            , { name = "removeLabel", type_ = "String", description = "The accessible name and the tooltip of the remove button, instead of \"Remove\" followed by the label. Use it when the label alone does not say what goes away, such as a filter chip whose label is a value:", control = Text }
            , { name = "outline", type_ = "Flag", description = "No fill: the tag keeps its border and text color but gets a transparent background.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "The size of the tag: `Small` (18px high), `Medium` (22px, the default) or `Large` (26px).", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the accessible name and the tooltip of the remove button (\"Remove Warehouse A\" in English). The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Alert" ->
            [ { name = "content", type_ = "String", description = "The visible text passed to view. Reset to keep each example's label.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the accessible name of the close button (\"Close\", or \"Close: \" and the title in English) and the texts of `stale`. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            , { name = "tone", type_ = "Tone", description = "The kind of message, which sets its color, its icon and how screen readers announce it. The default is `Info`. `Success`, `Warning` and `Danger` have colors and icons of their own; `Primary` looks like `Info` and `Neutral` is gray.", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "title", type_ = "String", description = "A short bold line above the message. There is no title by default.", control = Text }
            , { name = "icon", type_ = "Icon", description = "Replaces the icon that comes with the tone: `Icon.info` for `Neutral`, `Primary` and `Info`, `Icon.checkCircle` for `Success`, `Icon.warning` for `Warning` and `Icon.errorCircle` for `Danger`.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "onDismiss", type_ = "msg", description = "Shows a close button that sends this message. The alert does not hide itself: stop showing it when the message arrives in your `update` function. The button had the keyboard focus, and it goes away with the alert, so move the focus to the next sensible place in the same branch (`Klar.focus`), or it falls to the page:", control = Example }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons or links shown below the message, for the next step the user can take, such as \"Try again\".", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "banner", type_ = "Flag", description = "A flat style for the top of a page or a panel: square corners, a border only along the bottom edge and a colored bar at the left edge.", control = Choice [ "Enabled", "omit" ] }
            , { name = "compact", type_ = "Flag", description = "Tighter padding and smaller text, for alerts inside forms and tables. Alerts follow a compact density of the application (`Klar.Settings`) without it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "polite", type_ = "Flag", description = "Announce it politely (`role=\"status\"`) even for a warning or an error, so a screen reader finishes what it is reading first. Use it for notices that show up by themselves while the user works, never for the result of an action.", control = Choice [ "Enabled", "omit" ] }
            , { name = "id", type_ = "String", description = "The DOM id of the alert. The alert can then take the focus (`Klar.focus`), for example the summary of the errors after a failed submit, and a field can point at it with `aria-describedby`. There is no id by default.", control = Text }
            ]

        "Spinner" ->
            [ { name = "size", type_ = "Size", description = "The size of the spinner: `Small` (12px), `Medium` (14px, the default of `view`) or `Large` (22px, drawn in the primary color, the default of `panel`).", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "label", type_ = "String", description = "Text that screen readers announce as a polite status message, for example \"Saving order\". The default is no label, which makes the spinner a decoration that is hidden from assistive technology. It has no effect on `panel`, whose text is visible.", control = Text }
            , { name = "loading", type_ = "Bool", description = "Whether the wait is on, from your model. The default is `True`. With `False` nothing is drawn, but a labelled spinner (and a `panel`) keeps its empty live region in the page, so the next `True` is announced. Render the spinner all the time with `loading` rather than adding it with an `if`.", control = Choice [ "True", "False" ] }
            , { name = "compact", type_ = "Flag", description = "Less vertical space around a `panel`, for tables and small panels. It is the space of a compact [Klar.EmptyState](Klar-EmptyState), and a panel follows a compact density of the application (`Klar.Settings`) without it. It has no effect on `view`.", control = Choice [ "Enabled", "omit" ] }
            ]

        "Progress" ->
            [ { name = "value", type_ = "Float", description = "The progress as a percentage from 0 to 100. The default is 0. A number outside the range is clamped to it, and NaN or infinity count as 0. Also turns `indeterminate` off, and replaces an earlier `outOf` together with its \"3 of 5\" text.", control = Number }
            , { name = "outOf", type_ = "Int -> Int", description = "Sets the value from a count of steps: `outOf 3 5` is 60%. With `showValue` the text reads \"3 of 5\" instead of a percentage. A total of 0 or less gives 0%, and more done than the total fills the bar while the text still says what you gave it (\"7 of 5\"), so a wrong count is not hidden. Also turns `indeterminate` off. It replaces an earlier `value`, a", control = Example }
            , { name = "indeterminate", type_ = "Flag", description = "The length of the task is unknown: an animated bar (or a spinning ring) without a value. It has no `aria-valuenow` and shows no value text. In a bar with `segments` no step is filled, whatever the value was; a wave of highlights runs over the steps instead. A later `value` or `outOf` turns it off.", control = Choice [ "Enabled", "omit" ] }
            , { name = "label", type_ = "String", description = "Visible text above the bar, or inside the ring. It is also the accessible name, unless you give an `ariaLabel`. A `Small` ring is too small for the text and only keeps the accessible name.", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "An accessible name for when you want no visible label. It wins over `label` as the accessible name. When neither is given, the name is the built-in text (\"Progress\" in English).", control = Text }
            , { name = "showValue", type_ = "Flag", description = "Shows the value as text next to the label: \"62%\", or \"3 of 5\" after `outOf`. It is hidden while the bar is `indeterminate`. A ring always shows its value.", control = Choice [ "Enabled", "omit" ] }
            , { name = "valueText", type_ = "String", description = "Replaces the value text with your own, for example \"12 of 40 hours\", and turns `showValue` on. Screen readers get the same text as `aria-valuetext`.", control = Text }
            , { name = "tone", type_ = "Tone", description = "The color: `Primary` (blue, the default), `Success`, `Warning`, `Danger` or `Neutral` (gray). `Info` looks like `Primary`.", control = Choice [ "Neutral", "Primary", "Info", "Success", "Warning", "Danger" ] }
            , { name = "size", type_ = "Size", description = "The thickness of the bar: `Small` is 4px, `Medium` 8px and `Large` 12px. For a ring it is the diameter: 36px, 64px and 88px. The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "striped", type_ = "Flag", description = "Moving diagonal stripes on the filled part of the bar. They stand still for users who prefer reduced motion. Bars only, and not together with `segments`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "segments", type_ = "Int", description = "Divides the bar into this many equal steps (at least 2, at most 40) instead of one continuous bar. The number of filled steps is the value rounded down to a whole step, so the last step fills only when the task is done. An `indeterminate` bar fills no step and shows a wave of highlights over the steps. Bars only.", control = Number }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the word \"of\" in the text of `outOf`, the accessible name \"Progress\", and the number format (\"62%\" in English). The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "EmptyState" ->
            [ { name = "icon", type_ = "Icon", description = "The large icon above the title. The default is `Icon.inbox`.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "title", type_ = "String", description = "The headline, such as \"No orders yet\": say what is missing. Without one the state says \"Nothing to show\" (in the `locale`), so it is never only an icon. An empty title (or one of spaces only) renders no headline element at all.", control = Text }
            , { name = "description", type_ = "String", description = "A sentence under the title that says why there is nothing here or what to do about it. There is none by default.", control = Text }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons or links below the text, for the obvious next steps, such as \"Create order\" and \"Import orders\". The first is the main one. There are none by default.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "compact", type_ = "Flag", description = "Less vertical space and a smaller icon, for use inside tables and small panels. It follows a compact density of the application (`Klar.Settings`) without it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "headingLevel", type_ = "Int", description = "Makes the title a heading of this level (1 to 6), for an empty state that is the main content of a page or a section, so that screen reader users find it by its heading. The default is no heading: a plain line, right inside a table cell or a popup.", control = Number }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the default title (\"Nothing to show\" in English). The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "ErrorState" ->
            [ { name = "onRetry", type_ = "msg", description = "The message sent when the user presses the \"Try again\" button. Without `onRetry` there is no button. With it, the button is still hidden when trying again would not help (see `Klar.Remote.isRetryable`).", control = Example }
            , { name = "actions", type_ = "List (Html msg)", description = "Buttons or links for another way forward, shown after the retry button (or alone, when there is none): \"Sign in\" for `Remote.unauthorized`, \"Request access\" for `Remote.forbidden`, \"Back to orders\" for `Remote.notFound`. There are none by default.", control = Choice [ "Configured content", "Badge", "Button", "Stack", "Empty" ] }
            , { name = "compact", type_ = "Flag", description = "Less vertical space and a smaller icon, for use inside tables and small panels. It follows a compact density of the application (`Klar.Settings`) without it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "headingLevel", type_ = "Int", description = "Makes the title a heading of this level (1 to 6), for an error state that is the main content of a page or a section. The default is no heading: a plain line, right inside a table cell or a small panel.", control = Number }
            , { name = "polite", type_ = "Flag", description = "Announce it politely (`role=\"status\"`) instead of at once (`role=\"alert\"`), so a screen reader finishes what it is reading first. Use it for the small regions of a dashboard, which tend to fail together: one assertive message for the page is enough.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the label of the retry button (\"Try again\" in English). The default is `Locale.default`, which is English. The title and the detail come from the `Problem`: the texts the problem has of its own, or the ready-made ones for its kind in this language.", control = Choice [ "en", "nb" ] }
            ]

        "NotificationCenter" ->
            [ { name = "id", type_ = "String", description = "A DOM id unique on the page, also a stable focus target after removing an item or retrying. The unread switch uses this id too, so supply it for multiple inboxes on one page. Absent by default.", control = Text }
            , { name = "unreadOnly", type_ = "Bool -> (Bool -> msg)", description = "Controlled unread filter and its change handler. Without it all items appear.", control = Example }
            , { name = "onOpen", type_ = "(id -> msg)", description = "Opens a notification by id. Opening does not also send `onRead`.", control = Example }
            , { name = "onRead", type_ = "(id -> msg)", description = "Adds a mark-as-read action to unread notifications.", control = Example }
            , { name = "onDismiss", type_ = "(id -> msg)", description = "Adds an explicit dismiss action. The application decides when to remove data.", control = Example }
            , { name = "onReadAll", type_ = "(List id -> msg)", description = "Adds \"Mark loaded as read\", sending only the ids of loaded unread items. The action is disabled when there are none.", control = Example }
            , { name = "onLoadMore", type_ = "msg", description = "Adds a load-more button, even when the unread filter has no matches.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Retry for initial failures and failed refreshes. Absent by default.", control = Example }
            , { name = "locale", type_ = "Locale", description = "Language of built-in text. Defaults to English.", control = Choice [ "en", "nb" ] }
            , { name = "settings", type_ = "Settings", description = "Time zone and date formatting. Defaults to `Settings.default`, explicitly UTC.", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            ]

        "Form.Layout" ->
            [ { name = "id", type_ = "String", description = "The DOM id of the form. `view` puts it on the `form` element. The error summary and the status line make their own ids from it (`<id>-summary` and `<id>-status`), which is how `focusSummary` and `focusStatus` find them, so give the same id to all of them. Give every form on a page its own id: without one the summary and the status line use `form-su", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name of the form (`view`). A form with a name is a landmark that screen reader users can jump to.", control = Text }
            , { name = "onSubmit", type_ = "msg", description = "The message sent when the form is submitted, by a submit button (`Button.submit`) or by Enter in a field (`view`). The browser's own submit, which would reload the page, is prevented only when this is given: always give a form an `onSubmit`. Enter submits also while a request is running, so ignore the message in `update` while the status is `Submit", control = Example }
            , { name = "stacked", type_ = "Flag", description = "Puts the title and description of every section above its fields instead of beside them (`view`). Sections already stack on a narrow window; use this for a form in a narrow place such as a dialog or a drawer, where the width of the window says nothing about the room the form has.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the texts that `errorSummary`, `status`, `unsavedChanges` and `unsavedFlag` draw (\"The form has 2 errors\", \"Saving ...\", \"Try again\", \"Unsaved changes\" ...). The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            , { name = "labels", type_ = "List ( String, String )", description = "Pairs of a field's DOM id and its label, so that a problem reads \"Email: Invalid email address\" in the error summary instead of the message alone (`errorSummary`). A problem whose field has no pair shows only its message.", control = Example }
            , { name = "onFocusField", type_ = "(String -> msg)", description = "What a click on a problem in the error summary sends: the DOM id of its field. Handle it with `Klar.focus` (`errorSummary`). Without this each problem is a plain link to `#<field id>`, which an application built with `Browser.application` receives as a URL request; always give it.", control = Example }
            , { name = "onRetry", type_ = "msg", description = "Shows a \"Try again\" button in the failure message when the submit failed in a way that is worth trying again: the network, a timeout, a server error or an unknown error, see `Remote.isRetryable` (`status`). The button sends this message.", control = Example }
            , { name = "onDismiss", type_ = "msg", description = "Shows a close button on the success and failure messages and sends this message when it is pressed (`status`). The button goes away with the message, so in the update that handles it move focus to a control that makes sense (the submit button, with `Klar.focus`); otherwise keyboard focus falls back to the page.", control = Example }
            , { name = "onSave", type_ = "msg", description = "Gives the unsaved-changes banner a \"Save\" button that sends this message (`unsavedChanges`). Without it the banner has no such button.", control = Example }
            , { name = "onDiscard", type_ = "msg", description = "Gives the unsaved-changes banner a \"Discard\" button that sends this message (`unsavedChanges`). Without it the banner has no such button.", control = Example }
            , { name = "saving", type_ = "Bool", description = "While `True` the \"Save\" button of the banner shows a spinner and ignores clicks, and the \"Discard\" button is disabled (`unsavedChanges`). Pass a field of your model that is `True` while the request is running. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "sticky", type_ = "Flag", description = "The banner sticks to the top of the scrolling area while the page scrolls (`unsavedChanges`).", control = Choice [ "Enabled", "omit" ] }
            ]

        "TextInput" ->
            [ { name = "label", type_ = "String", description = "The label shown above the field. It is connected to the input, so clicking it focuses the input and screen readers read it as the name of the input. Give every field a label, or hide it with `labelHidden`.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Hides the `label` visually but keeps it for screen readers. Use it when the surroundings already show what the field is for.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "Help text shown under the field, for example the format you expect. Screen readers read it together with the label (`aria-describedby`).", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the field and marks the field invalid (red border, `aria-invalid`). Screen readers announce the message when it appears. To show an error only sometimes, use `errorMaybe`.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Just message` shows the message and `Nothing` shows no error. It fits the result of a validator.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required` on the input. This does not validate anything; check the value yourself and show an `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text such as `\"(optional)\"` shown after the label of a field that is not `required`. By default nothing is shown.", control = Text }
