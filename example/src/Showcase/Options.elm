            , { name = "size", type_ = "Size", description = "The size of the field: `Small` (26px high), `Medium` (32px) or `Large` (40px) at the default density (see `Klar.Theme` for the others), from [Klar.Theme](Klar-Theme). Default `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "name", type_ = "String", description = "The HTML `name` of the input. Browsers use it to fill in saved values, and a native form sends the value under this name. Default: none.", control = Text }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the default accessible name (\"Search\"), the clear button (\"Clear search\") and what screen readers hear while the search runs (\"Searching ...\"). Default `Locale.default`, which is English. Texts you pass in yourself are shown as they are.", control = Choice [ "en", "nb" ] }
            ]

        "TagInput" ->
            [ { name = "label", type_ = "String", description = "The label shown above the field. It is connected to the text input, so clicking it focuses the input and screen readers read it as the name of the input (and of the list of chips). Give every field a label, or hide it with `labelHidden`.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Hides the `label` visually but keeps it for screen readers. Use it when the surroundings already show what the field is for.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "Help text shown under the field, for example the format you expect. Screen readers read it together with the label (`aria-describedby`).", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the field and marks the field invalid (red border, `aria-invalid`). Screen readers announce the message when it appears. To show an error only sometimes, use `errorMaybe`. A refusal from the field itself (a duplicate, a tag that fails `validate`, too many tags) is shown instead until the next keystroke.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Just message` shows the message and `Nothing` shows no error. It fits the result of a validator.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required` on the text input. This does not validate anything; check `values` for an empty list yourself and show an `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text such as `\"(optional)\"` shown after the label of a field that is not `required`. By default nothing is shown.", control = Text }
            , { name = "placeholder", type_ = "String", description = "Text shown inside the field while there are no tags; it disappears when the first tag is added. It is not a substitute for a `label`. Default: none.", control = Text }
            , { name = "maxTags", type_ = "Int", description = "At most this many tags. The field then shows a counter such as `3/8`. Once the limit is reached the user can still type, but a new tag is refused with a message (\"You can only add 8 values\" in English) and its text stays in the field; so are the tags over the limit in a pasted list. Default: no limit.", control = Number }
            , { name = "delimiters", type_ = "List Char", description = "The characters that end a tag when they are typed or pasted. Default `[ ',' ]`; add `';'` to accept semicolons too. Enter always ends a tag, and a pasted tab or line break always splits. With an empty list only Enter (and leaving the field) adds tags, and a comma becomes part of the tag. The comma and semicolon of Chinese and Japanese input (`，` `、", control = Example }
            , { name = "validate", type_ = "(String -> Maybe String)", description = "A check that runs on each new tag (trimmed, and after the checks for duplicates and `maxTags`). Return `Just message` to refuse the tag: the message is shown under the field and the text of the tag stays in the field so that the user can correct it. Return `Nothing` to accept the tag. Default: every tag is accepted. The check runs in the view, so t", control = Example }
            , { name = "keepDraftOnBlur", type_ = "Flag", description = "Leaving the field keeps the text that is still being typed as text instead of turning it into a tag. By default leaving the field adds it, as Enter does.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed, nothing can be typed, and the chips lose their remove buttons. Default `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the user can focus the field but not add or remove tags: the chips lose their remove buttons, and Backspace removes nothing. Default `False`.", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The size of the field and of its chips: `Small`, `Medium` or `Large`, from [Klar.Theme](Klar-Theme). The field is at least 26px, 32px or 40px high at the default density (see `Klar.Theme` for the others), and grows when the chips wrap onto more lines. Default `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the refusal messages (\"... has already been added\", \"You can only add 8 values\"), what screen readers are told (\"... added\", \"... removed\", \"2 values: red, blue\") and the name of each remove button (\"Remove ...\"). Default `Locale.default`, which is English. Texts you pass in yourself are shown as they are.", control = Choice [ "en", "nb" ] }
            ]

        "FileDrop" ->
            [ { name = "label", type_ = "String", description = "The label shown above the field. It is connected to the file input, so clicking it focuses the input and screen readers read it as the name of the input. Give every field a label, or hide it with `labelHidden`.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Hides the `label` visually but keeps it for screen readers. Use it when the surroundings already show what the field is for.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "Help text shown between the label and the drop zone, so that people read what is allowed before they choose. Screen readers read it together with the label (`aria-describedby`). Without a `hint`, the text is built from the rules (`accept`, `maxSize`, `maxFiles`), for example \"Allowed types: PDF · Max 5.0 MB per file\"; a `hint` replaces it.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the field and marks the field invalid (red border on the drop zone, `aria-invalid`). Screen readers announce the message when it appears. To show an error only sometimes, use `errorMaybe`. The messages for refused files are shown on the files themselves; this one is for what the application knows, such as \"Attach at lea", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Just message` shows the message and `Nothing` shows no error. It fits the result of a validator.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required` on the file input. This does not validate anything; check `values` for an empty list yourself and show an `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text such as `\"(optional)\"` shown after the label of a field that is not `required`. By default nothing is shown.", control = Text }
            , { name = "accept", type_ = "List String", description = "The kinds of file that are allowed: extensions (`\".pdf\"`), media types (`\"application/pdf\"`) and groups (`\"image/*\"`). A file is accepted when it matches any of them, without regard to case. The list also goes to the browser's file dialog, and dropped files are checked too. Default: every file is accepted.", control = Text }
            , { name = "maxSize", type_ = "Int", description = "The largest size of a file, in bytes (`5000000` is 5 MB). A larger file is refused as `TooLarge`; a file of exactly this size is accepted. Default: no limit.", control = Number }
            , { name = "maxFiles", type_ = "Int", description = "The most files that can be accepted. A limit above 1 also allows choosing several files at once (it implies `multiple`). Files over the limit are refused as `TooMany`, and are accepted again if the user removes other files.", control = Number }
            , { name = "multiple", type_ = "Flag", description = "Allows more than one file. Without it a new choice replaces the old one, and when several files are dropped at once only the first is used. `maxFiles 1` takes priority: it keeps the field a single-file field.", control = Choice [ "Enabled", "omit" ] }
            , { name = "compact", type_ = "Flag", description = "A one-line drop zone for tight forms, instead of the taller default.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed and the button and the drop zone do nothing. Default `False`. The file input stays focusable (`aria-disabled`, not the `disabled` attribute), so a zone that is disabled while the user is on it, such as during an upload that starts right after a choice, keeps the focus.", control = Choice [ "True", "False" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the button and the drop zone (\"Choose files\", \"Drag and drop files here\", \"or\"), the text built from the rules, the messages of refused files (\"File type not allowed\", \"File is too large (max 5.0 MB)\", \"Too many files (max 3)\", \"File already added\"), the names of the remove buttons and of the list (\"Selected files", control = Choice [ "en", "nb" ] }
            ]

        "InlineEdit" ->
            [ { name = "ariaLabel", type_ = "String", description = "What the text is about, such as `\"Customer name\"`, for screen readers only: it is the accessible name of the input, and part of the name of the text button (\"Edit Customer name: Ada Lovelace\", in the case it was given). Give every inline edit one; the visible label, when there is one, is yours (a `DescriptionList` term, a heading).", control = Text }
            , { name = "placeholder", type_ = "String", description = "Text shown inside the input while editing, when the input is empty. Default: none.", control = Text }
            , { name = "emptyText", type_ = "String", description = "Shown in gray in reading mode when the text is empty. Default \"Click to add\" (see `locale`).", control = Text }
            , { name = "maxLength", type_ = "Int", description = "Limits the text to this many characters (the HTML `maxlength` of the input). There is no counter. Default: no limit.", control = Number }
            , { name = "validate", type_ = "(String -> Maybe String)", description = "Checked when the user confirms, with the text trimmed. Return `Just message` to keep the input open and show the message under it (it goes away when the user types again), or `Nothing` to go on and save. Default: every text is accepted.", control = Example }
            , { name = "multiline", type_ = "Flag", description = "The text has several lines, such as a note or a description. The editor is a text area: Enter starts a new line, Ctrl+Enter (Cmd+Enter on a Mac) saves, Escape cancels and leaving the field saves, as in a single line. In reading mode the line breaks are kept. Default: a single line.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "While `True` the text cannot be edited: no pencil, and a click does nothing. It stays the same button, marked `aria-disabled` and out of the Tab order, so a field that becomes disabled while it has the focus keeps it. Default `False`.", control = Choice [ "True", "False" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: \"Click to add\", the accessible name \"Edit ...\", the \"Save\" and \"Cancel\" buttons, \"Saving ...\", \"Saved\", \"Could not save.\" and \"Try again\". Default `Locale.default`, which is English. Texts you pass in yourself are shown as they are.", control = Choice [ "en", "nb" ] }
            ]

        "Checkbox" ->
            [ { name = "label", type_ = "String", description = "The text next to the box; a click on it toggles the checkbox. Without a label the checkbox is bare: give it an `ariaLabel`.", control = Text }
            , { name = "hint", type_ = "String", description = "A line of gray explanation under the label (beside the box when there is no label), joined to the checkbox with `aria-describedby`. An empty text counts as none.", control = Text }
            , { name = "error", type_ = "String", description = "Marks the checkbox invalid (a red box and `aria-invalid`) and shows the message in red under the label (beside the box when there is no label). The message is joined to the checkbox with `aria-describedby`, and screen readers read it when it appears. An empty text counts as no error, so there is never a red box without a message.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, for a message that may not be there: `Nothing` shows no error. It goes well with `Validate.errorFor`.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the checkbox as required, such as \"I accept the terms\": a `*` after the label (hidden from screen readers) and `aria-required` on the checkbox. It only marks the checkbox and checks nothing.", control = Choice [ "Enabled", "omit" ] }
            , { name = "checked", type_ = "Bool", description = "Whether the box is checked. The default is `False`. While the box is `indeterminate` it shows a dash, whatever this says.", control = Choice [ "True", "False" ] }
            , { name = "indeterminate", type_ = "Bool", description = "Shows a dash instead of a check, for \"some selected\". The box is the native \"indeterminate\" state of a checkbox, which assistive technology announces as \"mixed\". A click on an indeterminate box sends `True` to `onCheck`, because that is what \"select all\" is expected to do. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "disabled", type_ = "Bool", description = "Dims the checkbox and makes it unchangeable and unfocusable (the HTML `disabled` attribute). The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "Shows the value without letting the user change it, for a record the user may read but not edit. Unlike `disabled` it is not dimmed, and Tab still reaches it, so a screen reader can read it (\"Newsletter, checkbox, checked, read only\"); a click or Space changes nothing. With `onCheck` the box stays the same native checkbox with `aria-readonly`, so i", control = Choice [ "True", "False" ] }
            , { name = "onCheck", type_ = "(Bool -> msg)", description = "The message sent when the user toggles the box. It gets the new value, `True` for checked; store it and give it back with `checked`. On a `readOnly` box a click is cancelled and this gets the value the box already has.", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the `input` element, for moving focus to it with `Klar.focus`. No id is set by default. The hint and the error message get the ids `<id>-description` and `<id>-error`, and the label text `<id>-label` while there is a hint or an error to leave out of the name. Without an id they are made from the label (or the `ariaLabel`), so give che", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name when there is no visible label, such as \"Select all orders\" or \"Select order 1042\". It becomes the `aria-label` of the input.", control = Text }
            , { name = "size", type_ = "Size", description = "The size of the box and its label: `Small`, `Medium` or `Large` (see [Klar.Theme](Klar-Theme)). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "tabIndex", type_ = "Int", description = "The `tabindex` of the input. `-1` takes the checkbox out of the tab order (it can still be clicked and focused by script), for a list of checkboxes that is reached some other way, like the rows of [Klar.Table](Klar-Table), where the arrow keys move between rows. Without it the browser decides: a checkbox is reached with Tab.", control = Number }
            ]

        "CheckboxGroup" ->
            [ { name = "label", type_ = "String", description = "The legend of the group: its name, shown above the options. Give every group one, or screen readers cannot say what the choices are for; `labelHidden` keeps it out of sight.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keep the label (the legend) for screen readers only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A line of help under the group, joined to it with `aria-describedby` so a screen reader reads it with the group.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message in red under the group and marks it: the empty boxes get a red border. Screen readers read the message when it appears and with the group afterwards (`aria-describedby`); a plain group has no `aria-invalid`.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, for a message that may not be there: `Nothing` shows no error. It goes well with `Validate.errorFor`.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the group as required with a `*` after the legend. It is a visual mark and checks nothing: ARIA has no required state for a group of checkboxes, so tell screen reader users in the `hint` too (\"Choose at least one\").", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text shown after the legend of a group that is not required, such as \"(optional)\". There is no built-in text: without this, an optional group gets no mark.", control = Text }
            , { name = "id", type_ = "String", description = "The DOM id of the group. Its first checkbox that can be changed gets this id, so an error summary can move focus into the group; the other checkboxes get `<id>-<position>` (counting from 0) and the fieldset gets `<id>-group`. When no checkbox can take the focus, the fieldset gets the id instead.", control = Text }
            , { name = "options", type_ = "List (Option value)", description = "The choices of the group, in the order they are shown.", control = Example }
            , { name = "selected", type_ = "List value", description = "The values of the checked options. A value that no option has is not shown, but it stays in the selection that `onChange` sends. The default is the empty list.", control = Example }
            , { name = "onChange", type_ = "(List value -> msg)", description = "The message sent when a checkbox (or the select-all box) is changed. It gets the complete new selection, in the order of the options (values that no option has come last, and no value comes twice), so the application can store it as it is. Without it the group is read-only (see `readOnly`).", control = Example }
            , { name = "selectAll", type_ = "Flag", description = "Adds a \"Select all\" checkbox above the options. It is checked when every option that can be changed is checked, shows a dash when only some are, and checks or clears all of them with one click. Options made with `disabledOption` keep their state. The text is \"Select all\" in English; `selectAllLabel` changes it.", control = Choice [ "Enabled", "omit" ] }
            , { name = "selectAllLabel", type_ = "String", description = "Replaces the built-in \"Select all\" text of the select-all checkbox. This also switches `selectAll` on.", control = Text }
            , { name = "horizontal", type_ = "Flag", description = "Lay the options out in a row, which wraps when there is not enough room, instead of in a column.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "Disables the whole group, including the select-all box: dimmed, skipped by Tab, and nothing can be changed. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "Shows the selection without letting the user change it, for a record the user may read but not edit. Each box is a read-only checkbox (see `Checkbox.readOnly`): not dimmed, reached with Tab and read by screen readers, but a click or Space changes nothing and nothing is sent to `onChange`. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The size of the checkboxes and their text: `Small`, `Medium` or `Large` (see [Klar.Theme](Klar-Theme)). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the label of the select-all box. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Radio" ->
            [ { name = "label", type_ = "String", description = "The legend of the group: its name, shown above the options. Give every group one, or screen readers cannot say what the choice is for; `labelHidden` keeps it out of sight.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keep the label (the legend) for screen readers only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A line of help under the group, joined to it with `aria-describedby` so a screen reader reads it with the group.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message in red under the group and marks it invalid: the buttons get a red border and the group gets `aria-invalid`. Screen readers read the message when it appears.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, for a message that may not be there: `Nothing` shows no error. It goes well with `Validate.errorFor`.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the group as required: a `*` after the legend and `aria-required` on the group. It only marks the group and checks nothing.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "Text shown after the legend of a group that is not required, such as \"(optional)\". There is no built-in text: without this, an optional group gets no mark.", control = Text }
            , { name = "id", type_ = "String", description = "The DOM id of the group. Its chosen radio button, or the first one that can be chosen when none is, gets this id, so an error summary can move focus to the group (when no option can take the focus, the `fieldset` gets it). It is also the `name` that all the radio buttons share, which is what makes them one group for the browser.", control = Text }
            , { name = "options", type_ = "List (Option value)", description = "The choices of the group, in the order they are shown.", control = Example }
            , { name = "selected", type_ = "Maybe value", description = "The value of the chosen option, or `Nothing` when none is chosen, which is the default. A value that no option has chooses nothing.", control = Example }
            , { name = "onChange", type_ = "(value -> msg)", description = "The message sent when the user chooses an option, with the mouse or with the arrow keys. It gets the value of that option; store it and give it back with `selected`. Without it the group is read-only (see `readOnly`).", control = Example }
            , { name = "horizontal", type_ = "Flag", description = "Lay the options out in a row, which wraps when there is not enough room, instead of in a column.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "Disables the whole group: dimmed, skipped by Tab, and nothing can be chosen. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "Shows the choice without letting the user change it, for a record the user may read but not edit. Unlike `disabled` it is not dimmed, and Tab still reaches the chosen option, so a screen reader can read it (\"Express, radio button, checked\"); the group has `aria-readonly`, and the other options cannot be chosen with the mouse or the arrow keys: they", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The size of the radio buttons and their text: `Small`, `Medium` or `Large` (see [Klar.Theme](Klar-Theme)). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            ]

        "Switch" ->
            [ { name = "label", type_ = "String", description = "The text next to the switch. A click on it toggles the switch, and it is the accessible name of the switch. Without a label the switch is bare: give it an `ariaLabel`.", control = Text }
            , { name = "hint", type_ = "String", description = "A line of gray explanation under the label (beside the switch when there is no label), joined to the switch with `aria-describedby`. An empty text counts as none.", control = Text }
            , { name = "error", type_ = "String", description = "Marks the switch invalid (a red outline and `aria-invalid`) and shows the message in red under the label (beside the switch when there is no label). The message is joined to the switch with `aria-describedby`, and screen readers read it when it appears. An empty text counts as no error, so there is never a red outline without a message.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, for a message that may not be there: `Nothing` shows no error, such as the reason the last save failed.", control = Text }
            , { name = "checked", type_ = "Bool", description = "Whether the switch is on. The default is `False`. The switch always shows the value it is given, also while it is `loading`.", control = Choice [ "True", "False" ] }
            , { name = "disabled", type_ = "Bool", description = "Dims the switch and makes it unchangeable and unfocusable (the HTML `disabled` attribute). The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "Shows the setting without letting the user change it, for a user who may not change it. Unlike `disabled` it is not dimmed, and Tab still reaches it, so a screen reader can read it (\"Email notifications, switch, on, read only\"); a click or Space changes nothing. With `onCheck` the switch stays the same native input with `aria-readonly`, so it keeps", control = Choice [ "True", "False" ] }
            , { name = "loading", type_ = "Bool", description = "While `True` the application is saving the change: the knob shows a spinner, the switch announces `aria-busy`, a screen-reader-only \"Saving ...\" is read out, and the switch is `aria-disabled`: a click or Space changes nothing. The switch keeps the keyboard focus, so a keyboard user can go on from it. A click or Space while saving sends the value th", control = Choice [ "True", "False" ] }
            , { name = "onCheck", type_ = "(Bool -> msg)", description = "The message sent when the user toggles the switch. It gets the new value, `True` for on. Store it, or wait for the server to confirm it, and give it back with `checked`.", control = Example }
            , { name = "id", type_ = "String", description = "The DOM id of the switch, for moving focus to it with `Klar.focus`. No id is set by default. The label, the hint and the error message get the ids `<id>-label`, `<id>-description` and `<id>-error`. Without an id they are made from the label (or the `ariaLabel`), so give switches that share a text and show a hint or an error (the rows of a table) an", control = Text }
            , { name = "ariaLabel", type_ = "String", description = "The accessible name when there is no visible label, such as \"Active\" in the row of a table. It becomes the `aria-label` of the switch.", control = Text }
            , { name = "size", type_ = "Size", description = "The size of the switch and its text: `Small`, `Medium` or `Large` (see [Klar.Theme](Klar-Theme)). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "controlAtEnd", type_ = "Flag", description = "Puts the switch at the far end of the row with the label first, like a list of settings. The row fills the width of its container, so put the switch in something wider than itself, such as a card or a stack.", control = Choice [ "Enabled", "omit" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text, which is the \"Saving ...\" that screen readers hear while the switch is `loading`. The default is `Locale.default`, which is English.", control = Choice [ "en", "nb" ] }
            ]

        "Slider" ->
            [ { name = "label", type_ = "String", description = "The label, drawn at the left end of the line above the track. In a range slider it names the group of the two thumbs.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keep the label for screen readers only.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A line of help under the slider, joined to it with `aria-describedby` so a screen reader reads it with the slider.", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message in red under the slider and marks it invalid: the filled part of the track and the thumb turn red and the slider (each thumb of a range slider) gets `aria-invalid`. Screen readers read the message when it appears.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, for a message that may not be there: `Nothing` shows no error. It goes well with `Validate.errorFor`.", control = Text }
