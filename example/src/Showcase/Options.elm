            , { name = "error", type_ = "String", description = "Shows an error message under the field and marks the field invalid (`aria-invalid`). The message is announced to screen readers when it appears.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Nothing` shows no error. Handy with a validation result.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required`. It does not validate anything; show a problem with `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "A text after the label of a field that is not `required`, such as \"(optional)\".", control = Text }
            , { name = "placeholder", type_ = "String", description = "The text shown while nothing is chosen. Default \"Select ...\" (in the language of `locale`).", control = Text }
