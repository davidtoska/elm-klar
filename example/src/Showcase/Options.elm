            , { name = "readOnly", type_ = "Bool", description = "The date and the time can be seen, selected and copied but not changed, and the popups do not open. Unlike `disabled`, the inputs can still be focused. Default: `False`.", control = Choice [ "True", "False" ] }
            , { name = "clearable", type_ = "Flag", description = "Shows a small × button in each field while it has text; a button empties its own field and puts the focus back in it. The buttons are not in the tab order, and their accessible name is \"Clear field\". Default: no buttons.", control = Choice [ "Enabled", "omit" ] }
            , { name = "size", type_ = "Size", description = "The size of both fields, a `Size` from [Klar.Theme](Klar-Theme). Default: `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
