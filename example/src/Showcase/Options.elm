            , { name = "onCommit", type_ = "(Float -> msg)", description = "The message sent when the user has chosen a value with a single slider (`view`): once when the thumb is let go after a drag or a click on the track, and after every key press. It gets the new value. Use it for work that should not happen at every step of a drag, such as a request to the server; `onInput` still keeps the shown value up to date.", control = Example }
