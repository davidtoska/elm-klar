            , { name = "creatable", type_ = "(String -> id)", description = "Offers a first row `Create “Acme Ltd”` (for a search text \"Acme Ltd\") when the search text matches no option exactly, ignoring case and diacritics. Choosing it adds a new value and keeps the list open: the typed text is the label, and the value is what the function you give makes of the text (the text itself for a select of `String`s, or a value of", control = Example }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed, cannot be focused or opened, and its chips have no remove buttons. The values are kept. Pass a field of your model, for example while a form is saving. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "valueText", type_ = "(id -> String)", description = "How to write a value that is in none of the options, for example a saved value with a server search whose hits do not contain it. Without it the chip says \"Unknown value\". The label of an option you know about is always its own; use `setOptions` to give the select those options.", control = Example }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the field shows its chips but does not let the user change them: the list does not open, and there is no chevron, clear button or remove button. Unlike `disabled`, a read-only field can be focused. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The height of the field: `Small`, `Medium` or `Large` from [Klar.Theme](Klar-Theme). The default is `Medium`. The chips are small in a `Small` field and medium otherwise.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "visibleRows", type_ = "Int", description = "How many rows the open list shows before it scrolls. The default is 8; numbers below 3 or above 20 are brought into that range. Group headings take a row each.", control = Number }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: the placeholders, the search box, the chip and button labels, the counts under the list, the empty and error states and the labels for screen readers. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            , { name = "maxSelected", type_ = "Int", description = "The most values the user can choose, at least 1. By default there is no limit. When the limit is reached the options that are not chosen are dimmed and cannot be chosen, \"Select all\" adds only as many values as are left, and the status line reads \"3 of max 3 selected\". The limit is not applied to `setValues` and `setOptions`.", control = Number }
            , { name = "maxVisibleChips", type_ = "Int", description = "Shows at most this many chips and a \"+N\" chip for the rest. The default is 5, so that the field does not grow with the selection: \"Select all\" on a long list would otherwise fill the page. The chips wrap onto as many lines as they need, so a higher number makes a taller field; 200 is the most. The \"+N\" chip names the hidden values in its tooltip, a", control = Number }
            ]

        "Autocomplete" ->
            [ { name = "options", type_ = "List (Option id)", description = "Suggestions that the component filters itself as the user types: best match first, ignoring case and diacritics, with several words that must all match, in labels, descriptions and keywords (the scoring of [Klar.Search](Klar-Search)). The list is hidden while nothing matches. The default is no suggestions. Use `options` or `remote`, not both: the l", control = Example }
            , { name = "remote", type_ = "Remote (List (Option id))", description = "Suggestions from the backend, as a `Remote` (see [Klar.Remote](Klar-Remote)). Like `Select.remote`, the field filters and ranks them as the user types, the same as `options`, so a list loaded once needs nothing else; add `serverSearch` when the server does the searching. The list is hidden while the data is `NotAsked`, shows loading rows (and a spi", control = Choice [ "Not asked", "Loading", "Failed", "Refreshing", "Stale", "Empty" ] }
            , { name = "serverSearch", type_ = "Flag", description = "The server does the searching: the field shows the `remote` suggestions exactly as they come and does not filter them (the typed text is still highlighted in them), and says \"No suggestions\" on `Loaded []`. Fetch when `Autocomplete.query` changes: it waits for a pause of 300 ms in the typing, so **write no debounce of your own**, and drop an answer", control = Choice [ "Enabled", "omit" ] }
            , { name = "onRetry", type_ = "msg", description = "The message to send when the user presses the \"Try again\" button of the error shown when `remote` suggestions failed. The button appears only for problems that are worth retrying (network trouble, timeouts, server errors), and it is for the mouse: the focus stays in the field, where Enter sends the message as well and Tab moves on. For other proble", control = Example }
            , { name = "onEnter", type_ = "msg", description = "The message to send when the user presses Enter and no suggestion is highlighted, so the typed text is kept (to run a search for it, for example). It arrives after the component has updated `picked`, so you can read `Autocomplete.text` and `Autocomplete.picked` in your handler. Picking a suggestion is a state change instead: compare `Autocomplete.p", control = Example }
            , { name = "label", type_ = "String", description = "The label above the field. It names the input for screen readers.", control = Text }
            , { name = "labelHidden", type_ = "Flag", description = "Keeps the label for screen readers but does not draw it. Use it when the surroundings already name the field, as in a toolbar or a table cell. It needs a `label`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "hint", type_ = "String", description = "A short help text under the field. Screen readers read it with the field (`aria-describedby`).", control = Text }
            , { name = "error", type_ = "String", description = "Shows an error message under the field and marks the field invalid (`aria-invalid`). The message is announced to screen readers when it appears. It is safe to set it while the user types: the input keeps its place in the page, and so its keyboard focus, whether or not there is a label or a hint.", control = Text }
            , { name = "errorMaybe", type_ = "Maybe String", description = "Like `error`, but takes a `Maybe`: `Nothing` shows no error. Handy with a validation result.", control = Text }
            , { name = "required", type_ = "Flag", description = "Marks the field as required: an asterisk after the label and `aria-required` for screen readers. It does not validate anything; show a problem with `error`.", control = Choice [ "Enabled", "omit" ] }
            , { name = "optionalText", type_ = "String", description = "A text after the label of a field that is not `required`, such as \"(optional)\". Required fields show no such text.", control = Text }
            , { name = "placeholder", type_ = "String", description = "The text shown in the empty field. There is none by default: the field takes free text, so there is nothing general to say.", control = Text }
            , { name = "minChars", type_ = "Int", description = "How many characters the user has to type before suggestions appear. The default is 1, and spaces at the ends do not count. ArrowDown opens the list whatever the length.", control = Number }
            , { name = "clearable", type_ = "Flag", description = "Shows a small × that empties the field, closes the list and returns focus to the field. It is shown only while the field has text.", control = Choice [ "Enabled", "omit" ] }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed and cannot be focused or edited. The text is kept. Pass a field of your model, for example while a form is saving. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the field shows its text but does not let the user change it, and no suggestions are shown. Unlike `disabled`, a read-only field can be focused and its text selected. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The height of the field: `Small`, `Medium` or `Large` from [Klar.Theme](Klar-Theme). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
            , { name = "visibleRows", type_ = "Int", description = "How many suggestions show before the list scrolls. The default is 8; numbers below 3 or above 20 are brought into that range. Group headings take a row each.", control = Number }
            , { name = "prefixIcon", type_ = "Icon", description = "An icon at the start of the field, such as a magnifying glass. There is none by default.", control = Choice (List.map Icon.name Icons.all) }
            , { name = "settings", type_ = "Settings", description = "The settings of the application (`Klar.Settings`): the time zone of the time in \"Old data from 14:05\". Without it the time is written in UTC and ends in \"UTC\".", control = Choice [ "Compact", "Normal", "Comfortable" ] }
            , { name = "locale", type_ = "Locale", description = "The language of the built-in text: \"No suggestions\", \"Loading ...\", the suggestion count for screen readers, the \"Clear search\" label and the error state. The default is `Locale.default`, which is English. See [Klar.Locale](Klar-Locale).", control = Choice [ "en", "nb" ] }
            ]

        "VirtualList" ->
            [ { name = "rowHeight", type_ = "Int", description = "The height of every row in pixels (at least 1), for `view` and `viewGrouped`. The default is 32, the `--klar-option-h` token. The rows that `viewRow` returns must be exactly this high. `list` takes the height of its rows from the `density`.", control = Number }
            , { name = "height", type_ = "Int", description = "The maximum height of the list in pixels. The default is 320. A list with fewer rows is only as high as its rows.", control = Number }
            , { name = "overscan", type_ = "Int", description = "How many rows are rendered above and below the visible ones. The default is 6, so that fast scrolling does not show empty space.", control = Number }
            , { name = "density", type_ = "Density", description = "The height of the rows of a `list`: `Compact` 32 pixels, `Normal` 44 (the default, the height of a `ListItem.content` row with a second line) or `Comfortable` 56. A row is exactly this high, and what does not fit is cut.", control = Example }
            , { name = "onSelect", type_ = "(Int -> msg)", description = "Makes a `list` a list box that the keyboard moves through, and says what to tell when the user picks a row (clicks it, or presses Enter or Space on the active row). The message gets the number of the row, counting from 0, in the `Array` you gave to `list`.", control = Example }
            , { name = "selected", type_ = "Maybe Int", description = "The row that is picked now (it is marked, and is where the active row starts), or `Nothing`. The list does not keep it: you set it from the message of `onSelect`.", control = Number }
