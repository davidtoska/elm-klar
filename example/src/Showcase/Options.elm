            , { name = "clearable", type_ = "Flag", description = "Shows a small x in the field that removes the chosen node or nodes. In a single field Backspace and Delete do the same on the focused field. Nothing is shown while nothing is chosen.", control = Choice [ "Enabled", "omit" ] }
            , { name = "valueText", type_ = "(id -> String)", description = "How to write an id that is in none of the nodes you give, for example a saved value inside a branch that is not loaded. Without it the field says \"Unknown value\". The label of a node the field knows about is always its own.", control = Example }
            , { name = "disabled", type_ = "Bool", description = "While `True` the field is dimmed, cannot be focused or opened, and has no clear button. The value is kept. Pass a field of your model, for example while a form is saving. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "readOnly", type_ = "Bool", description = "While `True` the field shows its value but does not let the user change it: the popup does not open, and there is no chevron or clear button. Unlike `disabled`, a read-only field can be focused. The two are independent; with both set the field is disabled. The default is `False`.", control = Choice [ "True", "False" ] }
            , { name = "size", type_ = "Size", description = "The height of the field: `Small`, `Medium` or `Large` from [Klar.Theme](Klar-Theme). The default is `Medium`.", control = Choice [ "Small", "Medium", "Large" ] }
