            , { name = "today", type_ = "Date", description = "Today, supplied by the application (the library never reads the clock). It marks the day in the calendar, powers the \"Today\" button, and completes the short forms `20.10`, `t`, `+3` and `-7` in the date field.", control = Text }
            , { name = "min", type_ = "Date", description = "The earliest date that can be chosen or typed: a typed date before it shows \"The date cannot be before\" followed by the limit, and the calendar disables the earlier days. The time of day has its own limit, `minTime`. Default: no limit.", control = Text }
            , { name = "max", type_ = "Date", description = "The latest date that can be chosen or typed: a typed date after it shows \"The date cannot be after\" followed by the limit, and the calendar disables the later days. The time of day has its own limit, `maxTime`. Default: no limit.", control = Text }
            , { name = "disabledWhen", type_ = "(Date -> Bool)", description = "Dates that cannot be used, such as weekends or public holidays. The calendar shows them disabled, and a typed one shows \"The date is not available\". Default: every date is allowed.", control = Example }
            , { name = "markers", type_ = "List Calendar.Marker", description = "Marks on days in the calendar, such as deliveries or deadlines. Make them with `Calendar.dot` and `Calendar.count` from [Klar.Calendar](Klar-Calendar). Default: none.", control = Example }
            , { name = "weekNumbers", type_ = "Flag", description = "Shows ISO 8601 week numbers in the calendar. Default: off.", control = Choice [ "Enabled", "omit" ] }
            , { name = "alignEnd", type_ = "Flag", description = "Aligns the right edges of the calendar and of the list of times with the right edges of their inputs, instead of the left edges. Use it for a control near the right side of the page, so that the popups do not run out of the window.", control = Choice [ "Enabled", "omit" ] }
